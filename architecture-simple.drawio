as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Report Service&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#6B7280&#x27;&gt;student reports, class statistics&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=14;fontFamily=Helvetica;fontColor=#1F2937;" vertex="1" parent="bl"><mxGeometry x="316.0" y="45" width="136.0" height="85" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;AI Providers&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#6B7280&#x27;&gt;STT, TTS, LLM OpenAI / Gemini&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=14;fontFamily=Helvetica;fontColor=#1F2937;" vertex="1" parent="bl"><mxGeometry x="464.0" y="45" width="136.0" height="85" as="geometry"/></mxCell><mxCell id="dl" value="&lt;b&gt;&lt;font color=&#x27;#B91C1C&#x27; style=&#x27;font-size:17px&#x27;&gt;Data Access Layer (AIVES.DAL)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=6;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontFamily=Helvetica;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="220" y="620" width="620" height="150" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;Repositories&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#6B7280&#x27;&gt;Account, Viva, Grading, Rubric&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=14;fontFamily=Helvetica;fontColor=#1F2937;" vertex="1" parent="dl"><mxGeometry x="20.0" y="45" width="185.33333333333334" height="85" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Entity Models&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#6B7280&#x27;&gt;SystemAccount, VivaSession, VivaGradingResult&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=14;fontFamily=Helvetica;fontColor=#1F2937;" vertex="1" parent="dl"><mxGeometry x="217.33333333333334" y="45" width="185.33333333333334" height="85" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;AIVESDbContext&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#6B7280&#x27;&gt;EF Core (Database First)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=14;fontFamily=Helvetica;fontColor=#1F2937;" vertex="1" parent="dl"><mxGeometry x="414.6666666666667" y="45" width="185.33333333333334" height="85" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;&lt;font color=&#x27;#2563EB&#x27; style=&#x27;font-size:16px&#x27;&gt;Web App&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#6B7280&#x27;&gt;startup project&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="170" height="50" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;&lt;font color=&#x27;#2563EB&#x27; style=&#x27;font-size:16px&#x27;&gt;.dll&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#6B7280&#x27;&gt;Class Library projects&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="170" height="50" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;&lt;font color=&#x27;#2563EB&#x27; style=&#x27;font-size:16px&#x27;&gt;Data&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#6B7280&#x27;&gt;AIVES.DAL&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="670" width="170" height="50" as="geometry"/></mxCell><mxCell id="ai" value="&lt;b&gt;External AI&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#6B7280&#x27;&gt;OpenAI / Gemini (HTTPS)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontSize=15;fontFamily=Helvetica;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="900" y="445" width="200" height="85" as="geometry"/></mxCell><mxCell id="sql" value="&lt;b&gt;SQL Server&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#6B7280&#x27;&gt;AIVES (DB)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=14;fillColor=#E5E7EB;strokeColor=#6B7280;strokeWidth=1.5;fontSize=15;fontFamily=Helvetica;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="910" y="665" width="180" height="85" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Legends&lt;/b&gt;&lt;br&gt;━━▶ : Request&lt;br&gt;┄┄▶ : Response" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#9CA3AF;fontSize=14;fontFamily=Helvetica;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="900" y="50" width="200" height="80" as="geometry"/></mxCell><mxCell id="ref" value="&lt;b&gt;Project references&lt;/b&gt;&lt;br&gt;Web → BLL, DAL (DAL for DI registration only)&lt;br&gt;BLL → DAL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F8FAFC;strokeColor=#9CA3AF;fontSize=13;fontFamily=Helvetica;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="880" y="800" width="240" height="80" as="geometry"/></mxCell><mxCell id="note" value="Data flows both ways: requests go down, responses come back up. SignalR lets the server push events to the browser (STT results, follow-up questions, grading status)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="30" y="800" width="820" height="50" as="geometry"/></mxCell><mxCell id="r1" value="HTTP / SignalR" style="html=1;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=1.5;fontSize=12;exitX=0.45;exitY=1;entryX=0.45;entryY=0;" edge="1" parent="1" source="br" target="pl"><mxGeomet