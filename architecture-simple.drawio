<mxfile host="drawio"><diagram id="aives-simple" name="AIVES Architecture (simple)"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1160" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="AIVES System Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontFamily=Helvetica;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="220" y="0" width="620" height="36" as="geometry"/></mxCell><mxCell id="br" value="&lt;b&gt;Web Browser (User)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#6B7280&#x27;&gt;HTML, Bootstrap, SignalR client, JS audio recorder&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#9CA3AF;fontSize=15;fontFamily=Helvetica;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="220" y="50" width="620" height="60" as="geometry"/></mxCell><mxCell id="pl" value="&lt;b&gt;&lt;font color=&#x27;#1D4ED8&#x27; style=&#x27;font-size:17px&#x27;&gt;Presentation Layer (StudentNameMVC)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=6;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=2;fontFamily=Helvetica;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="220" y="180" width="620" height="150" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Razor Pages&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#6B7280&#x27;&gt;Viva, Grading, Reports, Account, Admin AI&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=14;fontFamily=Helvetica;fontColor=#1F2937;" vertex="1" parent="pl"><mxGeometry x="20.0" y="45" width="185.33333333333334" height="85" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;SignalR Hub&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27; color=&#x27;#6B7280&#x27;&gt;VivaHub + Timer, real-time event push&