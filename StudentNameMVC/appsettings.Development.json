{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "VivaInterview": {
    "Enabled": true
  },
  "AiServices": {
    "UseMock": false,
    "AllowMockFallback": false,
    "SpeechToTextTimeoutSeconds": 90,
    "TextToSpeechTimeoutSeconds": 20,
    "FollowUpTimeoutSeconds": 35
  }
}
