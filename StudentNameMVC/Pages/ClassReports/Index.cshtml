@page "/ClassReports"
@model StudentNameMVC.Pages.ClassReports.IndexModel
@{
    ViewData["Title"] = "Thống kê Lớp Thi Vấn Đáp (Giảng viên)";
    var availableExams = Model.AvailableExams;
    var availableClasses = Model.AvailableClasses;
    string selectedTeacherId = Model.SelectedTeacherId;
    string selectedClassId = Model.SelectedClassId;
    string selectedExamId = Model.SelectedExamId;
    int? selectedAttemptOrdinal = Model.SelectedAttemptOrdinal;

    int passedCount = Model.Statistics?.GradeExportRows.Count(r => r.ResultStatus == "ĐẠT") ?? 0;
    int failedCount = Model.Statistics?.GradeExportRows.Count(r => r.ResultStatus == "CHƯA ĐẠT") ?? 0;
    int pendingCount = (Model.Statistics?.GradeExportRows.Count ?? 0) - passedCount - failedCount;
    bool hasAnyGraded = passedCount + failedCount > 0;
}

<div class="viva-exam-shell">
    <!-- 1. Header Banner & Quick Export -->
    <div class="viva-header-card">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge tag-purple">BÁO CÁO LỚP HỌC PHẦN</span>
                    <span class="badge tag-cyan">NHÓM 6 REPORTING</span>
                </div>
                <h3 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.5px;">
                    <i class="bi bi-bar-chart-steps text-primary me-2"></i>Thống Kê Năng Lực Học Tập Toàn Lớp
                </h3>
                <p class="text-secondary small mb-0">Hệ thống khảo thí thông minh AIVES · Phân tích câu hỏi khó nhất, tỷ lệ đạt chuẩn và phân bố điểm số sinh viên.</p>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <a asp-page="/ClassReports/ExportGradeSheet"
                   asp-route-teacherId="@selectedTeacherId"
                   asp-route-classId="@selectedClassId"
                   asp-route-examId="@selectedExamId"
                   class="btn btn-success rounded-pill px-4 fw-bold shadow-sm d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-excel-fill"></i> Xuất Bảng Điểm (.CSV)
                </a>
                <span class="badge tag-purple fs-6 px-3 py-2"><i class="bi bi-person-workspace me-1"></i>GV: @selectedTeacherId</span>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 2. Modern Filter Card -->
    <div class="viva-panel-card p-4">
        <form method="get" asp-page="/ClassReports/Index" class="row g-3 align-items-end">
            <input type="hidden" name="teacherId" value="@selectedTeacherId" />

            <div class="col-md-3">
                <label class="form-label fw-bold small text-secondary mb-1">Mã đề / Nhóm thi:</label>
                <select name="classId" class="form-select" style="border-radius: 12px; padding: 10px 14px; background: #f8fafc; border: 1px solid #edf2f7;">
                    @foreach (var cls in availableClasses)
                    {
                        <option value="@cls" selected="@(cls == selectedClassId)">@cls</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold small text-secondary mb-1">Kỳ thi vấn đáp:</label>
                <select name="examId" class="form-select" style="border-radius: 12px; padding: 10px 14px; background: #f8fafc; border: 1px solid #edf2f7;">
                    @foreach (var ex in availableExams)
                    {
                        <option value="@ex.ExamId" selected="@(ex.ExamId == selectedExamId)">@ex.ExamTitle</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold small text-secondary mb-1">Phạm vi lượt thi (DEC-07, DEC-08):</label>
                <select name="attemptOrdinal" class="form-select" style="border-radius: 12px; padding: 10px 14px; background: #f8fafc; border: 1px solid #edf2f7;">
                    <option value="1" selected="@(selectedAttemptOrdinal == 1)">Lượt thi số 1 (Mặc định)</option>
                    <option value="2" selected="@(selectedAttemptOrdinal == 2)">Lượt thi số 2</option>
                    <option value="" selected="@(!selectedAttemptOrdinal.HasValue)">Gộp tất cả các lượt</option>
                </select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-pill fw-bold">
                    <i class="bi bi-funnel-fill me-1"></i> Lọc dữ liệu
                </button>
            </div>
        </form>
    </div>

    @if (Model.Statistics != null)
    {
        var stats = Model.Statistics;
        <!-- 3. Four Metric Cards -->
        <div class="report-metric-grid">
            <div class="report-metric-card">
                <div class="report-metric-header">
                    <span class="stat-mini-metric text-uppercase fw-bold">Tổng số sinh viên</span>
                    <div class="stat-mini-icon-box icon-purple">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div>
                    <div class="report-metric-value text-primary">@stats.TotalStudentsCount</div>
                    <div class="report-metric-sub">Đã thi trong đề @stats.ClassId</div>
                </div>
            </div>

            <div class="report-metric-card">
                <div class="report-metric-header">
                    <span class="stat-mini-metric text-uppercase fw-bold">Điểm TB toàn lớp</span>
                    <div class="stat-mini-icon-box icon-cyan">
                        <i class="bi bi-award-fill"></i>
                    </div>
                </div>
                <div>
                    @if (hasAnyGraded)
                    {
                        <div class="report-metric-value text-success">@stats.AverageClassScore.ToString("0.00") / 10</div>
                        <div class="report-metric-sub">Tính trên điểm TB của từng SV đã chấm</div>
                    }
                    else
                    {
                        <div class="report-metric-value text-secondary fs-4">Chưa chấm</div>
                        <div class="report-metric-sub">Các lượt thi đang ở trạng thái chờ chấm</div>
                    }
                </div>
            </div>

            <div class="report-metric-card">
                <div class="report-metric-header">
                    <span class="stat-mini-metric text-uppercase fw-bold">Câu hỏi khó nhất</span>
                    <div class="stat-mini-icon-box icon-pink">
                        <i class="bi bi-fire"></i>
                    </div>
                </div>
                <div>
                    <div class="report-metric-value text-danger fs-4">
                        @if (stats.HardestQuestions.Any())
                        {
                            @string.Join(", ", stats.HardestQuestions.Select(q => q.QuestionId))
                        }
                        else
                        {
                            <span>Chưa xác định</span>
                        }
                    </div>
                    <div class="report-metric-sub">
                        @(stats.HardestQuestions.Any() ? $"Tỷ lệ không đạt: {stats.HardestQuestions.First().FailRate}%" : "Chưa chấm / chưa đủ dữ liệu")
                    </div>
                </div>
            </div>

            <div class="report-metric-card">
                <div class="report-metric-header">
                    <span class="stat-mini-metric text-uppercase fw-bold">Phạm vi thống kê</span>
                    <div class="stat-mini-icon-box icon-purple">
                        <i class="bi bi-diagram-3-fill"></i>
                    </div>
                </div>
                <div>
                    <div class="report-metric-value text-dark fs-5">@stats.DataScopeLabel</div>
                    <div class="report-metric-sub text-truncate">@stats.ExamTitle</div>
                </div>
            </div>
        </div>

        <!-- 4. Hardest Question Alert Callout (DEC-09) -->
        @if (stats.HardestQuestions.Any())
        {
            <div class="p-4 rounded-4 mb-4" style="background: #fff1f2; border: 1px solid #fecdd3;">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-exclamation-octagon-fill fs-4 text-danger me-2"></i>
                    <h5 class="fw-bold text-danger mb-0">Phân tích Câu hỏi Khó nhất (Tỷ lệ không đạt cao nhất):</h5>
                </div>
                <p class="mb-2 text-dark">
                    Hệ thống xác định có <strong>@stats.HardestQuestions.Count câu hỏi</strong> có tỷ lệ sinh viên trả lời không đạt cao nhất là
                    <strong class="text-danger">@stats.HardestQuestions.First().FailRate%</strong> (đồng hạng theo DEC-09):
                </p>
                <ul class="mb-0 text-dark">
                    @foreach (var hq in stats.HardestQuestions)
                    {
                        <li class="mb-1">
                            <strong>[@hq.QuestionId - Thang Bloom: @hq.CognitiveLevel]</strong> @hq.QuestionTitle
                            — <em class="text-danger">Số lượt không đạt: @hq.FailedCount / @hq.TotalAssessed (Tỷ lệ đạt: @hq.PassRate%)</em>
                        </li>
                    }
                </ul>
            </div>
        }

        <!-- 5. Charts & Analytics Section (Two Visual Charts Side-by-Side) -->
        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="viva-panel-card h-100">
                    <div class="viva-panel-header">
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">
                                <i class="bi bi-bar-chart-fill text-primary me-2"></i>Biểu Đồ Phân Bố Điểm (DEC-06)
                            </h5>
                            <small class="text-muted">Trục X: Mức điểm trung bình · Trục Y: Số lượng sinh viên</small>
                        </div>
                    </div>
                    <div class="viva-panel-body p-4">
                        @if (stats.ScoreDistribution.Any())
                        {
                            <canvas id="scoreDistributionChart" height="230"></canvas>
                        }
                        else
                        {
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-hourglass-split fs-2 d-block mb-2"></i>
                                Chưa chấm điểm — biểu đồ phân bố điểm sẽ hiển thị sau khi có kết quả chấm.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="viva-panel-card h-100">
                    <div class="viva-panel-header">
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">
                                <i class="bi bi-pie-chart-fill text-success me-2"></i>Tỷ Lệ Kết Quả Toàn Lớp
                            </h5>
                            <small class="text-muted">Phân loại trạng thái kết quả của sinh viên</small>
                        </div>
                    </div>
                    <div class="viva-panel-body p-4 d-flex flex-column align-items-center justify-content-center">
                        @if (hasAnyGraded)
                        {
                            <div style="width: 200px; height: 200px; position: relative;">
                                <canvas id="passFailDonutChart"></canvas>
                            </div>
                            <div class="d-flex justify-content-center gap-4 mt-3">
                                <div class="d-flex align-items-center gap-2">
                                    <span style="width: 12px; height: 12px; border-radius: 50%; background: #10b981; display: inline-block;"></span>
                                    <span class="small fw-bold text-dark">Đạt: @passedCount SV</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span style="width: 12px; height: 12px; border-radius: 50%; background: #ef4444; display: inline-block;"></span>
                                    <span class="small fw-bold text-dark">Chưa đạt: @failedCount SV</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <span class="badge tag-pink fs-6 px-3 py-2 rounded-pill mb-2">
                                    <i class="bi bi-hourglass-split me-1"></i>Chưa chấm: @pendingCount SV
                                </span>
                                <p class="small mb-0 mt-2">Chưa có lượt thi nào được chấm điểm nên chưa phân loại Đạt / Chưa đạt.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 6. Question Ranking Card (DEC-09) -->
        <div class="viva-panel-card mb-4">
            <div class="viva-panel-header">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-trophy-fill text-warning me-2"></i>Xếp Hạng Câu Trả Lời Tốt Theo Thứ Tự Tỷ Lệ Đạt (DEC-09)
                    </h5>
                    <small class="text-muted">Được sắp xếp theo thứ tự tỷ lệ đạt giảm dần (ngưỡng đạt cấu hình bởi GV)</small>
                </div>
            </div>
            <div class="viva-panel-body p-0">
                <div class="table-responsive">
                    <table class="lesson-table">
                        <thead>
                            <tr>
                                <th>Hạng</th>
                                <th>Mã câu</th>
                                <th>Cấp độ Bloom</th>
                                <th>Tiến độ tỷ lệ đạt</th>
                                <th>Số lượt Đạt / Tổng số</th>
                                <th>Đánh giá</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!stats.QuestionStats.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">Chưa chấm — chưa có dữ liệu xếp hạng câu hỏi.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var q in stats.QuestionStats)
                                {
                                    <tr>
                                        <td class="fw-bold">#@q.Rank</td>
                                        <td class="fw-bold text-primary">@q.QuestionId</td>
                                        <td><span class="badge tag-cyan">@q.CognitiveLevel</span></td>
                                        <td style="min-width: 180px;">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" style="height: 8px; border-radius: 9999px; background: #e2e8f0;">
                                                    <div class="progress-fill @(q.PassRate >= 60 ? "bg-success" : "bg-warning")"
                                                         style="width: @q.PassRate%; height: 100%; border-radius: 9999px;"></div>
                                                </div>
                                                <span class="fw-bold small">@q.PassRate%</span>
                                            </div>
                                        </td>
                                        <td><strong>@q.PassedCount</strong> / @q.TotalAssessed</td>
                                        <td>
                                            @if (q.IsHardest)
                                            {
                                                <span class="badge tag-pink">Khó nhất</span>
                                            }
                                            else if (q.PassRate >= 60)
                                            {
                                                <span class="badge tag-cyan">Tốt</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-secondary border">Trung bình</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 7. Grade Sheet Table Preview for Class (with Realtime Quick Search) -->
        <div class="viva-panel-card mb-4">
            <div class="viva-panel-header">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-file-earmark-spreadsheet-fill text-success me-2"></i>Bảng Điểm Tổng Hợp (@stats.ClassId)
                    </h5>
                    <small class="text-muted">Danh sách kết quả thi vấn đáp của từng sinh viên</small>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="position-relative">
                        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted small"></i>
                        <input type="text" id="studentFilterInput" class="form-control form-control-sm ps-5 rounded-pill"
                               style="background: #f8fafc; border: 1px solid #edf2f7; width: 220px;"
                               placeholder="Tìm tên hoặc MSSV..." />
                    </div>
                    <a asp-page="/ClassReports/ExportGradeSheet"
                       asp-route-teacherId="@selectedTeacherId"
                       asp-route-classId="@selectedClassId"
                       asp-route-examId="@selectedExamId"
                       class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold">
                        <i class="bi bi-download me-1"></i> Tải .CSV Excel
                    </a>
                </div>
            </div>
            <div class="viva-panel-body p-0">
                <div class="table-responsive">
                    <table class="lesson-table" id="gradeTable">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Mã SV</th>
                                <th>Họ và tên</th>
                                <th>Mã đề / Lớp</th>
                                <th>Lượt thi 1</th>
                                <th>Lượt thi 2</th>
                                <th>Điểm TB</th>
                                <th>Kết quả</th>
                                <th>Ghi chú</th>
                                <th class="text-center">Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int stt = 1; }
                            @foreach (var row in stats.GradeExportRows)
                            {
                                <tr class="student-row">
                                    <td>@(stt++)</td>
                                    <td class="fw-bold text-primary student-id">@row.StudentId</td>
                                    <td class="fw-semibold student-name">@row.StudentName</td>
                                    <td>@row.ClassId</td>
                                    <td><span class="badge tag-purple">@row.Attempt1Score</span></td>
                                    <td><span class="badge tag-purple">@row.Attempt2Score</span></td>
                                    <td><span class="fw-bold text-success fs-6">@row.AverageScore</span></td>
                                    <td>
                                        @if (row.ResultStatus == "ĐẠT")
                                        {
                                            <span class="badge bg-success text-white rounded-pill px-3">ĐẠT</span>
                                        }
                                        else if (row.ResultStatus == "CHƯA ĐẠT")
                                        {
                                            <span class="badge bg-danger text-white rounded-pill px-3">CHƯA ĐẠT</span>
                                        }
                                        else
                                        {
                                            <span class="badge tag-pink rounded-pill px-3">Chưa chấm</span>
                                        }
                                    </td>
                                    <td>
                                        @if (row.Note == "AI chấm, chờ giảng viên duyệt")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-robot me-1"></i>AI chấm, chờ giảng viên duyệt</span>
                                        }
                                        else if (row.Note == "Điểm chính thức")
                                        {
                                            <span class="badge bg-success text-white"><i class="bi bi-shield-check me-1"></i>Điểm chính thức</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">@row.Note</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @* No attemptOrdinal: StudentDetail then selects the newest attempt by default. *@
                                        <a asp-page="/ClassReports/StudentDetail"
                                           asp-route-studentId="@row.StudentId"
                                           asp-route-classId="@selectedClassId"
                                           asp-route-examId="@selectedExamId"
                                           class="table-action-btn" title="Xem chi tiết bài thi của sinh viên này">
                                            <i class="bi bi-arrow-up-right"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 8. Full Question Statistics Table in Question Bank -->
        <div class="viva-panel-card mb-4">
            <div class="viva-panel-header">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-table text-primary me-2"></i>Chi Tiết Thống Kê Từng Câu Hỏi Trong Ngân Hàng Đề Thi
                    </h5>
                    <small class="text-muted">Đối soát cấp độ nhận thức Bloom và tỷ lệ đạt/không đạt của từng câu</small>
                </div>
            </div>
            <div class="viva-panel-body p-0">
                <div class="table-responsive">
                    <table class="lesson-table">
                        <thead>
                            <tr>
                                <th>Mã</th>
                                <th style="width: 40%;">Nội dung câu hỏi</th>
                                <th>Cấp độ Bloom</th>
                                <th>Tổng đánh giá</th>
                                <th>Đạt</th>
                                <th>Không đạt</th>
                                <th>Tỷ lệ đạt</th>
                                <th>Tỷ lệ không đạt</th>
                                <th>Đánh giá</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!stats.QuestionStats.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4 text-muted">Chưa chấm — chưa có thống kê đạt/không đạt theo câu hỏi.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var q in stats.QuestionStats)
                                {
                                    <tr style="@(q.IsHardest ? "background-color: #fff1f2;" : "")">
                                        <td class="fw-bold text-primary">@q.QuestionId</td>
                                        <td class="fw-semibold text-dark">@q.QuestionTitle</td>
                                        <td><span class="badge tag-cyan">@q.CognitiveLevel</span></td>
                                        <td><span class="badge bg-light text-dark border">@q.TotalAssessed</span></td>
                                        <td class="text-success fw-bold">@q.PassedCount</td>
                                        <td class="text-danger fw-bold">@q.FailedCount</td>
                                        <td><span class="badge tag-cyan">@q.PassRate%</span></td>
                                        <td><span class="badge tag-pink">@q.FailRate%</span></td>
                                        <td>
                                            @if (q.IsHardest)
                                            {
                                                <span class="badge bg-danger text-white rounded-pill px-3"><i class="bi bi-fire me-1"></i>Khó nhất</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Bình thường</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const filterInput = document.getElementById('studentFilterInput');
            if (filterInput) {
                filterInput.addEventListener('input', function () {
                    const query = this.value.toLowerCase().trim();
                    const rows = document.querySelectorAll('#gradeTable tbody .student-row');
                    rows.forEach(row => {
                        const id = row.querySelector('.student-id')?.textContent.toLowerCase() || '';
                        const name = row.querySelector('.student-name')?.textContent.toLowerCase() || '';
                        if (id.includes(query) || name.includes(query)) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            }

            @if (Model.Statistics != null)
            {
                if (Model.Statistics.ScoreDistribution.Any())
                {
                    var labelsJson = System.Text.Json.JsonSerializer.Serialize(Model.Statistics.ScoreDistribution.Select(b => b.Score.ToString("0.0") + "đ"));
                    var dataJson = System.Text.Json.JsonSerializer.Serialize(Model.Statistics.ScoreDistribution.Select(b => b.StudentCount));

                    <text>
                    const ctxHistogram = document.getElementById('scoreDistributionChart')?.getContext('2d');
                    if (ctxHistogram) {
                        new Chart(ctxHistogram, {
                            type: 'bar',
                            data: {
                                labels: @Html.Raw(labelsJson),
                                datasets: [{
                                    label: 'Số lượng sinh viên',
                                    data: @Html.Raw(dataJson),
                                    backgroundColor: '#5b52f9',
                                    hoverBackgroundColor: '#4b42e6',
                                    borderRadius: 8
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                scales: {
                                    y: {
                                        beginAtZero: true,
                                        grid: { color: '#f1f4f9' },
                                        ticks: { stepSize: 1, font: { family: 'Plus Jakarta Sans' } }
                                    },
                                    x: {
                                        grid: { display: false },
                                        ticks: { font: { family: 'Plus Jakarta Sans' } }
                                    }
                                },
                                plugins: {
                                    legend: { display: false },
                                    tooltip: {
                                        backgroundColor: '#111827',
                                        padding: 12,
                                        cornerRadius: 10,
                                        callbacks: {
                                            label: function(context) {
                                                return context.raw + ' sinh viên đạt mức điểm này';
                                            }
                                        }
                                    }
                                }
                            }
                        });
                    }
                    </text>
                }

                if (hasAnyGraded)
                {
                    <text>
                    const ctxDonut = document.getElementById('passFailDonutChart')?.getContext('2d');
                    if (ctxDonut) {
                        new Chart(ctxDonut, {
                            type: 'doughnut',
                            data: {
                                labels: ['Đạt chuẩn', 'Chưa đạt'],
                                datasets: [{
                                    data: [@passedCount, @failedCount],
                                    backgroundColor: ['#10b981', '#ef4444'],
                                    hoverBackgroundColor: ['#059669', '#dc2626'],
                                    borderWidth: 0
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                cutout: '72%',
                                plugins: {
                                    legend: { display: false },
                                    tooltip: {
                                        backgroundColor: '#111827',
                                        padding: 10,
                                        cornerRadius: 8
                                    }
                                }
                            }
                        });
                    }
                    </text>
                }
            }
        });
    </script>
}
