@page "/ClassReports/StudentDetail"
@model StudentNameMVC.Pages.ClassReports.StudentDetailModel
@{
    var report = Model.Report;
    ViewData["Title"] = $"Chi tiết bài thi - {report.StudentName} ({report.StudentId})";
    string selectedClassId = Model.SelectedClassId;
    string selectedExamId = Model.SelectedExamId;
    int? selectedAttemptOrdinal = Model.SelectedAttemptOrdinal;
}

<div class="viva-exam-shell">
    <!-- 1. Header Banner & Back Button -->
    <div class="viva-header-card">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small">
                        <li class="breadcrumb-item">
                            <a asp-page="/ClassReports/Index"
                               asp-route-classId="@selectedClassId"
                               asp-route-examId="@selectedExamId"
                               asp-route-attemptOrdinal="@selectedAttemptOrdinal"
                               class="text-decoration-none text-primary fw-bold">
                                <i class="bi bi-bar-chart-steps me-1"></i>Thống kê Lớp @selectedClassId
                            </a>
                        </li>
                        <li class="breadcrumb-item active text-muted" aria-current="page">Hồ sơ bài thi cá nhân</li>
                    </ol>
                </nav>
                <h3 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.5px;">
                    <i class="bi bi-file-earmark-person-fill text-primary me-2"></i>Chi Tiết Bài Thi Vấn Đáp Sinh Viên
                </h3>
                <p class="text-secondary small mb-0">Hệ thống khảo thí thông minh AIVES · Giám sát và đánh giá câu trả lời theo chuẩn rubric (Human-in-the-loop).</p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-page="/ClassReports/Index"
                   asp-route-classId="@selectedClassId"
                   asp-route-examId="@selectedExamId"
                   asp-route-attemptOrdinal="@selectedAttemptOrdinal"
                   class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại Bảng Điểm
                </a>
                <span class="badge tag-purple fs-6 px-3 py-2"><i class="bi bi-building me-1"></i>Đề / Lớp: @selectedClassId</span>
            </div>
        </div>
    </div>

    <!-- 2. Student & Exam Profile Card -->
    <div class="viva-panel-card p-4">
        <div class="row g-4 align-items-center">
            <div class="col-md-3 border-end">
                <div class="d-flex align-items-center gap-3">
                    <div class="brand-icon-box" style="width: 50px; height: 50px; font-size: 24px; border-radius: 14px;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-bold d-block">Sinh viên</span>
                        <h4 class="fw-bold mb-0 text-dark">@report.StudentName</h4>
                        <span class="badge tag-purple mt-1">MSSV: @report.StudentId</span>
                    </div>
                </div>
            </div>

            <div class="col-md-3 border-end">
                <span class="text-muted small text-uppercase fw-bold d-block mb-1">Kỳ thi vấn đáp</span>
                <h6 class="fw-bold text-dark mb-1">@report.ExamTitle</h6>
                <span class="badge tag-cyan">Mã đề: @report.ExamId</span>
            </div>

            <div class="col-md-3 border-end text-center">
                <span class="text-muted small text-uppercase fw-bold d-block mb-1">Tiến độ thi (DEC-01)</span>
                <h3 class="fw-bold text-dark mb-0">@report.CompletedAttemptsCount / @report.MaxAllowedAttemptsCount</h3>
                <small class="text-muted">lượt đã hoàn thành</small>
            </div>

            <div class="col-md-3 text-center">
                <span class="text-muted small text-uppercase fw-bold d-block mb-1">Điểm trung bình (DEC-05)</span>
                @if (report.AverageScore.HasValue)
                {
                    <h3 class="fw-bold text-success mb-0">@report.AverageScore.Value <span class="fs-6 text-muted">/ 10</span></h3>
                    <span class="badge @(report.AverageScore.Value >= report.PassThresholdScore ? "bg-success" : "bg-danger") rounded-pill px-3 mt-1">
                        @(report.AverageScore.Value >= report.PassThresholdScore ? "ĐẠT YÊU CẦU" : "CHƯA ĐẠT")
                    </span>
                }
                else
                {
                    <h4 class="text-secondary mb-0">Chưa chấm</h4>
                    <small class="text-muted">Đang chờ chấm thi</small>
                }
            </div>
        </div>
    </div>

    <!-- 3. Attempts Tabs Section -->
    @if (report.Attempts == null || !report.Attempts.Any())
    {
        <div class="viva-panel-card p-5 text-center">
            <i class="bi bi-journal-x text-muted display-4 mb-3 d-block"></i>
            <h5 class="fw-bold text-secondary">Sinh viên chưa tham gia lượt thi nào trong lớp này.</h5>
            <p class="text-muted small">Dữ liệu lượt thi sẽ hiển thị sau khi sinh viên hoàn thành buổi vấn đáp.</p>
        </div>
    }
    else
    {
        @* Bootstrap 5 tabs only switch inside .nav / [role="tablist"] and mark the selected button with .active. *@
        <div class="d-flex flex-wrap gap-2 mb-3" role="tablist" id="attemptTabs">
            @for (int i = 0; i < report.Attempts.Count; i++)
            {
                var att = report.Attempts[i];
                bool isActive = (selectedAttemptOrdinal.HasValue && att.AttemptOrdinal == selectedAttemptOrdinal.Value) || (!selectedAttemptOrdinal.HasValue && i == 0);
                <button class="btn btn-sm rounded-pill px-4 fw-bold btn-outline-primary @(isActive ? "active" : "")"
                        id="tab-att-@att.AttemptOrdinal"
                        role="tab"
                        aria-controls="pane-att-@att.AttemptOrdinal"
                        aria-selected="@(isActive ? "true" : "false")"
                        data-bs-toggle="pill"
                        data-bs-target="#pane-att-@att.AttemptOrdinal"
                        type="button">
                    <i class="bi bi-clock-history me-1"></i> Lượt thi số @att.AttemptOrdinal
                    @if (att.GradingState == AIVES.BLL.Models.ExamReporting.GradingState.Graded)
                    {
                        <span class="badge bg-white text-dark ms-2 border">@att.NormalizedScore / 10</span>
                    }
                    else if (att.GradingState == AIVES.BLL.Models.ExamReporting.GradingState.Pending)
                    {
                        <span class="badge bg-white text-secondary ms-2 border">Chưa chấm</span>
                    }
                </button>
            }
        </div>

        <div class="tab-content" id="attemptTabsContent">
            @for (int i = 0; i < report.Attempts.Count; i++)
            {
                var att = report.Attempts[i];
                bool isActive = (selectedAttemptOrdinal.HasValue && att.AttemptOrdinal == selectedAttemptOrdinal.Value) || (!selectedAttemptOrdinal.HasValue && i == 0);
                <div class="tab-pane fade @(isActive ? "show active" : "")" id="pane-att-@att.AttemptOrdinal" role="tabpanel" aria-labelledby="tab-att-@att.AttemptOrdinal">

                    <!-- Attempt Overview Header Card -->
                    <div class="viva-panel-card mb-4 p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="brand-icon-box" style="width: 44px; height: 44px; font-size: 20px; border-radius: 12px;">
                                    <i class="bi bi-award-fill"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold text-dark mb-1">Kết quả: Lượt thi số @att.AttemptOrdinal</h5>
                                    <div class="d-flex align-items-center gap-2 small text-muted">
                                        <span><i class="bi bi-calendar-event me-1"></i>@(att.CompletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</span>
                                        <span>&bull;</span>
                                        <span>Mã lượt thi: <code>@att.AttemptId</code></span>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                @if (att.ExamState == AIVES.BLL.Models.ExamReporting.ExamState.Abandoned)
                                {
                                    <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill">Bỏ dở (DEC-01)</span>
                                }
                                else if (att.GradingState == AIVES.BLL.Models.ExamReporting.GradingState.Pending)
                                {
                                    <div class="text-end">
                                        <span class="small text-muted d-block">Điểm tổng kết</span>
                                        <span class="fw-bold fs-5 text-secondary">Chưa chấm</span>
                                    </div>
                                    <div>
                                        <span class="badge tag-pink fs-6 px-3 py-2 rounded-pill"><i class="bi bi-hourglass-split me-1"></i>Chưa chấm</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-end">
                                        <span class="small text-muted d-block">Điểm tổng kết</span>
                                        <span class="fw-bold fs-4 text-success">@att.NormalizedScore / 10</span>
                                    </div>
                                    <div>
                                        @if (att.IsPassed)
                                        {
                                            <span class="badge bg-success fs-6 px-3 py-2 rounded-pill"><i class="bi bi-check-circle me-1"></i>ĐẠT CHUẨN</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill"><i class="bi bi-x-circle me-1"></i>CHƯA ĐẠT</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Questions List -->
                    <div class="mb-4">
                        <div class="section-header">
                            <h5 class="section-title">
                                <i class="bi bi-journal-text text-primary me-2"></i>Danh Sách Câu Hỏi & Nhật Ký Vấn Đáp
                            </h5>
                            <span class="badge tag-purple">Tổng số câu: @att.QuestionResults.Count</span>
                        </div>

                        <div class="vstack gap-4">
                            @foreach (var q in att.QuestionResults)
                            {
                                <partial name="_QuestionDetailCardPartial" model="q" />
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
