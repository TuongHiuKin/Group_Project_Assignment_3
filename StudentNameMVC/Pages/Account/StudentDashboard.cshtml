@page "/Account/StudentDashboard"
@model StudentNameMVC.Pages.Account.StudentDashboardModel
@using AIVES.BLL.Security
@{
    ViewData["Title"] = "Student Dashboard";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? ApplicationRoles.Staff;
    var userName = User.Identity?.Name ?? "Sinh viên";
    var studentId = !string.IsNullOrWhiteSpace(Model.StudentId) ? Model.StudentId : (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? User.Identity?.Name ?? "Chưa xác định");
}

<!-- Top Role Header Bar -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold mb-0 text-dark">Dashboard Sinh viên / Thí sinh</h4>
            <span class="badge rounded-pill px-3 py-1 small" style="background: #3b82f6; color: #ffffff;">
                <i class="bi bi-mortarboard-fill me-1"></i> Student Portal
            </span>
        </div>
        <p class="text-muted small mb-0">Cổng luyện thi vấn đáp AI Viva, chuẩn bị phòng thi âm thanh và theo dõi tiến độ cá nhân</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-page="/Viva/Index" class="btn btn-primary rounded-pill px-3 py-1.5 fw-bold shadow-sm">
            <i class="bi bi-camera-video-fill me-1"></i> Phòng thi Viva
        </a>
        <a href="/StudentReports" class="btn btn-outline-secondary rounded-pill px-3 py-1.5 fw-bold">
            <i class="bi bi-journal-check me-1"></i> Báo cáo Cá nhân
        </a>
    </div>
</div>

<!-- ========================================================
     DASHBOARD: SINH VIÊN / THÍ SINH (STUDENT DASHBOARD)
     ======================================================== -->
<div class="dashboard-grid">
    <!-- Main Column -->
    <div class="dashboard-main-col">
        <!-- 1. Hero Banner: Student Learning & Viva Exam -->
        <div class="hero-banner">
            <span class="hero-sparkle hero-sparkle-1">✦</span>
            <span class="hero-sparkle hero-sparkle-2">✦</span>
            <span class="hero-sparkle hero-sparkle-3">★</span>

            <span class="hero-tag">ONLINE VIVA EXAM</span>
            <h1 class="hero-title">Rèn luyện tư duy vấn đáp thông minh cùng Giám khảo AI</h1>
            <a asp-page="/Viva/Index" class="hero-btn">
                <span>Vào phòng thi ngay</span>
                <span class="hero-btn-arrow"><i class="bi bi-chevron-right"></i></span>
            </a>
        </div>

        <!-- 2. Student Quick Stat Mini Cards -->
        <div class="stat-mini-row">
            <div class="stat-mini-card">
                <div class="stat-mini-icon-box icon-purple">
                    <i class="bi bi-journal-check"></i>
                </div>
                <div class="stat-mini-info">
                    <span class="stat-mini-metric">@(Model.StudentReport?.CompletedAttemptsCount ?? 0)/@(Model.StudentReport?.MaxAllowedAttemptsCount ?? 3) lượt thi</span>
                    <span class="stat-mini-title">@Model.SelectedExamId</span>
                </div>
            </div>

            <div class="stat-mini-card">
                <div class="stat-mini-icon-box icon-pink">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div class="stat-mini-info">
                    <span class="stat-mini-metric">@(Model.StudentReport?.PendingAttemptsCount ?? 0) chờ chấm</span>
                    <span class="stat-mini-title">@(Model.StudentReport?.GradedAttemptsCount ?? 0) đã chấm</span>
                </div>
            </div>

            <div class="stat-mini-card">
                <div class="stat-mini-icon-box icon-cyan">
                    <i class="bi bi-award-fill"></i>
                </div>
                <div class="stat-mini-info">
                    @if (Model.StudentReport?.AverageScore != null)
                    {
                        <span class="stat-mini-metric">@Model.StudentReport.AverageScore.Value.ToString("F2")/10</span>
                        <span class="stat-mini-title">Điểm trung bình</span>
                    }
                    else
                    {
                        <span class="stat-mini-metric">Chưa chấm</span>
                        <span class="stat-mini-title">Điểm số</span>
                    }
                </div>
            </div>
        </div>

        <!-- 3. Đề thi vấn đáp sẵn sàng -->
        <div class="section-header">
            <h2 class="section-title">Chủ đề thi vấn đáp & Phòng thi sẵn sàng</h2>
        </div>

        <div class="course-cards-grid">
            @if (Model.AvailableExams.Count == 0)
            {
                <div class="p-4 text-center text-muted w-100">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    <span>Chưa có dữ liệu đề thi</span>
                </div>
            }
            else
            {
                @foreach (var ex in Model.AvailableExams)
                {
                    <div class="course-card">
                        <div class="course-card-thumb-wrap p-4 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%); min-height: 140px;">
                            <i class="bi bi-code-square text-white" style="font-size: 3rem;"></i>
                        </div>
                        <div class="course-card-body">
                            <span class="course-tag-pill tag-cyan">@ex.SubjectCode · @ex.ExamId</span>
                            <h3 class="course-card-title">@ex.ExamTitle</h3>
                            <div class="mt-auto pt-2">
                                <a asp-page="/Viva/Index" class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-bold">
                                    <i class="bi bi-play-circle-fill me-1"></i> Vào phòng thi
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- 4. Lịch sử bài thi cá nhân gần nhất -->
        <div class="section-header">
            <h2 class="section-title">Lịch sử bài thi gần đây</h2>
            <a href="/StudentReports" class="section-link">Xem báo cáo chi tiết</a>
        </div>

        <div class="lesson-table-wrap">
            @if (Model.StudentReport?.Attempts == null || Model.StudentReport.Attempts.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    <span>Chưa có dữ liệu bài thi</span>
                </div>
            }
            else
            {
                <table class="lesson-table">
                    <thead>
                        <tr>
                            <th>LƯỢT THI</th>
                            <th>MÃ ĐỀ</th>
                            <th>THỜI GIAN NỘP</th>
                            <th>ĐIỂM SỐ</th>
                            <th style="text-align: right;">BÁO CÁO</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var att in Model.StudentReport.Attempts)
                        {
                            <tr>
                                <td>
                                    <div class="table-mentor-cell">
                                        <div class="brand-icon-box" style="width: 34px; height: 34px; font-size: 16px; border-radius: 10px;">
                                            <i class="bi bi-mic-fill"></i>
                                        </div>
                                        <div>
                                            <div class="table-mentor-name">Lượt thi số @att.AttemptOrdinal</div>
                                            <div class="table-mentor-date">@att.ExamState.ToString()</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge tag-purple m-0">@att.ExamId</span></td>
                                <td class="text-secondary small">@(att.CompletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Đang thi")</td>
                                <td>
                                    @if (att.GradingState == AIVES.BLL.Models.ExamReporting.GradingState.Pending)
                                    {
                                        <span class="badge bg-secondary text-white rounded-pill px-3">Chưa chấm</span>
                                    }
                                    else
                                    {
                                        <strong class="fs-6">@att.NormalizedScore.ToString("F1") / 10</strong>
                                    }
                                </td>
                                <td style="text-align: right;">
                                    <a href="/StudentReports?examId=@Uri.EscapeDataString(att.ExamId)" class="table-action-btn" title="Xem báo cáo"><i class="bi bi-arrow-up-right"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- Right Statistic Column -->
    <div class="dashboard-side-col">
        <div class="statistic-panel">
            <div class="statistic-header">
                <h3 class="statistic-title">Học tập Cá nhân</h3>
                <button type="button" class="statistic-more-btn"><i class="bi bi-three-dots-vertical"></i></button>
            </div>

            <div class="statistic-user-card">
                <div class="avatar-progress-container">
                    <div class="avatar-progress-ring" style="background: conic-gradient(#3b82f6 0% 100%, #e2e8f0 100%);">
                        <div class="avatar-progress-inner">
                            <div class="brand-icon-box" style="width: 76px; height: 76px; font-size: 32px; border-radius: 50%;">
                                <i class="bi bi-mortarboard-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="statistic-user-greeting">Xin chào, @userName 🔥</div>
                <div class="statistic-user-sub">MSSV: @studentId · Đề @Model.SelectedExamId</div>
            </div>

            <!-- Mini Bar Chart -->
            <div class="chart-card">
                <div class="chart-bars-wrap">
                    <div class="chart-bar-col"><div class="chart-bar-pillar" style="height: 40%; background: #93c5fd;"></div></div>
                    <div class="chart-bar-col"><div class="chart-bar-pillar" style="height: 65%; background: #60a5fa;"></div></div>
                    <div class="chart-bar-col"><div class="chart-bar-pillar" style="height: 90%; background: #3b82f6;"></div></div>
                    <div class="chart-bar-col"><div class="chart-bar-pillar" style="height: 75%; background: #2563eb;"></div></div>
                </div>
                <div class="chart-axis-labels">
                    <span>Lần 1</span>
                    <span>Lần 2</span>
                    <span>Lần 3</span>
                    <span>Chuẩn</span>
                </div>
            </div>

            <!-- Quick Links -->
            <div>
                <h4 class="mentor-list-title mb-3">Lối tắt Thí sinh</h4>
                <div class="d-flex flex-column gap-2">
                    <a asp-page="/Viva/Index" class="btn btn-light text-start py-2.5 px-3 rounded-4 border d-flex align-items-center justify-content-between">
                        <span class="fw-bold small text-dark"><i class="bi bi-mic text-danger me-2"></i>Vào phòng thi AI</span>
                        <i class="bi bi-chevron-right text-muted small"></i>
                    </a>
                    <a href="/StudentReports" class="btn btn-light text-start py-2.5 px-3 rounded-4 border d-flex align-items-center justify-content-between">
                        <span class="fw-bold small text-dark"><i class="bi bi-journal-check text-primary me-2"></i>Báo cáo chi tiết</span>
                        <i class="bi bi-chevron-right text-muted small"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
