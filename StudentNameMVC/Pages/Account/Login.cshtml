@page "/Account/Login"
@model StudentNameMVC.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="card border-0 shadow-lg p-4 p-md-5 mx-auto" style="border-radius: 32px; background: #ffffff; max-width: 440px;">
    <div class="text-center mb-4">
        <div class="brand-icon-box mx-auto mb-3" style="width: 52px; height: 52px; font-size: 24px; border-radius: 16px;">
            <i class="bi bi-stars"></i>
        </div>
        <h3 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.5px;">Chào mừng đến với AIVES</h3>
        <p class="text-muted small">Hệ thống Thi Vấn Đáp & Học Tập Thông Minh AI</p>
    </div>

    <form asp-page="/Account/Login" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2" role="alert"></div>
        <input asp-for="ReturnUrl" type="hidden" />

        <div class="mb-3">
            <label asp-for="Email" class="form-label small fw-bold text-secondary mb-1">Email tài khoản</label>
            <div class="position-relative">
                <input asp-for="Email" class="form-control" style="border-radius: 14px; padding: 12px 16px; background: #f8fafc; border: 1px solid #edf2f7;" autocomplete="username" autofocus placeholder="admin@funews.com" />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label small fw-bold text-secondary mb-1">Mật khẩu</label>
            <div class="position-relative">
                <input asp-for="Password" class="form-control" style="border-radius: 14px; padding: 12px 16px; background: #f8fafc; border: 1px solid #edf2f7;" autocomplete="current-password" placeholder="••••••••" />
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small text-muted">Ghi nhớ tôi</label>
            </div>
            <a asp-page="/Account/ForgotPassword" class="small fw-semibold text-decoration-none" style="color: var(--primary-purple);">Quên mật khẩu?</a>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm" style="font-size: 15px;">
            <i class="bi bi-box-arrow-in-right me-2"></i> Đăng nhập
        </button>
    </form>

    <p class="text-center text-muted small mt-4 mb-0">
        Chưa có tài khoản?
        <a asp-page="/Account/Register" class="fw-semibold text-decoration-none" style="color: var(--primary-purple);">Tạo tài khoản sinh viên</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
