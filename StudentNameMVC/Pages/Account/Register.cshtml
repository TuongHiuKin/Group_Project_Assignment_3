@page "/Account/Register"
@model StudentNameMVC.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Tạo tài khoản";
}

<div class="card border-0 shadow-lg p-4 p-md-5 mx-auto" style="border-radius: 32px; background: #ffffff; max-width: 460px;">
    <div class="text-center mb-4">
        <div class="brand-icon-box mx-auto mb-3" style="width: 52px; height: 52px; font-size: 24px; border-radius: 16px;">
            <i class="bi bi-person-plus"></i>
        </div>
        <h3 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.5px;">Tạo tài khoản sinh viên</h3>
        <p class="text-muted small mb-0">Dành cho sinh viên dự thi vấn đáp AI</p>
    </div>

    @if (Model.Registered)
    {
        <div class="alert alert-success rounded-3 small py-3" role="alert">
            <i class="bi bi-check-circle me-1"></i>
            Tạo tài khoản thành công. Bạn có thể đăng nhập ngay bằng email vừa đăng ký.
        </div>
        <a asp-page="/Account/Login" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm" style="font-size: 15px;">
            <i class="bi bi-box-arrow-in-right me-2"></i> Đi tới đăng nhập
        </a>
    }
    else
    {
        <form asp-page="/Account/Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label small fw-bold text-secondary mb-1">Họ và tên</label>
                <input asp-for="FullName" class="form-control" style="border-radius: 14px; padding: 12px 16px; background: #f8fafc; border: 1px solid #edf2f7;"
                       autocomplete="name" autofocus placeholder="Nguyễn Văn A" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-bold text-secondary mb-1">Email tài khoản</label>
                <input asp-for="Email" class="form-control" style="border-radius: 14px; padding: 12px 16px; background: #f8fafc; border: 1px solid #edf2f7;"
                       autocomplete="username" placeholder="sinhvien@truong.edu.vn" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-bold text-secondary mb-1">Mật khẩu</label>
                <input asp-for="Password" class="form-control" style="border-radius: 14px; padding: 12px 16px; background: #f8fafc; border: 1px solid #edf2f7;"
                       autocomplete="new-password" placeholder="Tối thiểu 6 ký tự" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label small fw-bold text-secondary mb-1">Nhập lại mật khẩu</label>
                <input asp-for="ConfirmPassword" class="form-control" style="border-radius: 14px; padding: 12px 16px; background: #f8fafc; border: 1px solid #edf2f7;"
                       autocomplete="new-password" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.LecturerName))
            {
                <p class="text-muted small mb-3">
                    <i class="bi bi-person-badge me-1"></i>
                    Giảng viên phụ trách của bạn: <strong>@Model.LecturerName</strong>
                </p>
            }

            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm" style="font-size: 15px;">
                <i class="bi bi-person-plus me-2"></i> Tạo tài khoản
            </button>
        </form>

        <p class="text-center text-muted small mt-4 mb-0">
            Đã có tài khoản?
            <a asp-page="/Account/Login" class="fw-semibold text-decoration-none" style="color: var(--primary-purple);">Đăng nhập</a>
        </p>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
