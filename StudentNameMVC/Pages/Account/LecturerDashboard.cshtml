@page "/Account/LecturerDashboard"
@model StudentNameMVC.Pages.Account.LecturerDashboardModel
@using AIVES.BLL.Security
@{
    ViewData["Title"] = "Lecturer Dashboard";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? ApplicationRoles.Lecturer;
    var userName = User.Identity?.Name ?? "Giảng viên";
    var teacherId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "GV01";
    var defaultClass = Model.SelectedClassId ?? "Lớp học";
    var defaultExam = Model.SelectedExamId ?? "EXAM01";
}

<!-- Top Role Header Bar -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold mb-0 text-dark">Dashboard Giảng viên Khảo thí</h4>
            <span class="badge rounded-pill px-3 py-1 small" style="background: #0d9488; color: #ffffff;">
                <i class="bi bi-person-video3 me-1"></i> Lecturer Portal
            </span>
        </div>
        <p class="text-muted small mb-0">Theo dõi tiến độ khảo thí, đánh giá năng lực sinh viên và phân tích phổ điểm lớp học</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/ClassReports" class="btn btn-outline-secondary rounded-pill px-3 py-1.5 fw-bold">
            <i class="bi bi-bar-chart-steps me-1"></i> Thống kê Lớp học
        </a>
        @if (!string.IsNullOrWhiteSpace(Model.SelectedClassId) && !string.IsNullOrWhiteSpace(Model.SelectedExamId))
        {
            <a href="/ClassReports/ExportGradeSheet?teacherId=@Uri.EscapeDataString(teacherId)&amp;classId=@Uri.EscapeDataString(Model.SelectedClassId)&amp;examId=@Uri.EscapeDataString(Model.SelectedExamId)"
               class="btn rounded-pill px-3 py-1.5 fw-bold text-white shadow-sm" style="background: #0d9488;">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Xuất Bảng Điểm CSV
            </a>
        }
    </div>
</div>

<!-- ========================================================
     DASHBOARD: GIẢNG VIÊN KHẢO THÍ (LECTURER DASHBOARD)
     ======================================================== -->
<div class="dashboard-grid">
    <!-- Main Column -->
    <div class="dashboard-main-col">
        <!-- 1. Hero Banner: Lecturer Center -->
        <div class="hero-banner" style="background: linear-gradient(135deg, #0f766e 0%, #0d9488 50%, #14b8a6 100%);">
            <span class="hero-sparkle hero-sparkle-1">✦</span>
            <span class="hero-sparkle hero-sparkle-2">✦</span>
            <span class="hero-sparkle hero-sparkle-3">★</span>

            <span class="hero-tag" style="background: rgba(255, 255, 255, 0.2);">GIẢNG VIÊN KHẢO THÍ · HUMAN-IN-THE-LOOP</span>
            <h1 class="hero-title">Quản lý Khảo thí & Đánh giá Năng lực Sinh viên</h1>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <a href="/ClassReports" class="hero-btn" style="background: #111827;">
                    <span>Thống kê Lớp học</span>
                    <span class="hero-btn-arrow"><i class="bi bi-bar-chart-steps"></i></span>
                </a>
                @if (!string.IsNullOrWhiteSpace(Model.SelectedClassId) && !string.IsNullOrWhiteSpace(Model.SelectedExamId))
                {
                    <a href="/ClassReports/ExportGradeSheet?teacherId=@Uri.EscapeDataString(teacherId)&amp;classId=@Uri.EscapeDataString(Model.SelectedClassId)&amp;examId=@Uri.EscapeDataString(Model.SelectedExamId)"
                       class="btn btn-light rounded-pill px-4 py-2.5 fw-bold text-dark shadow-sm">
                        <i class="bi bi-file-earmark-excel-fill text-success me-1"></i> Xuất Bảng Điểm CSV
                    </a>
                }
            </div>
        </div>

        <!-- 2. Lecturer Quick Stat Mini Cards -->
        <div class="stat-mini-row">
            <div class="stat-mini-card">
                <div class="stat-mini-icon-box icon-cyan">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="stat-mini-info">
                    <span class="stat-mini-metric">@(Model.ClassStats?.TotalStudentsCount ?? 0) Sinh viên</span>
                    <span class="stat-mini-title">@defaultClass · @defaultExam</span>
                </div>
            </div>

            <div class="stat-mini-card">
                <div class="stat-mini-icon-box icon-purple">
                    <i class="bi bi-award-fill"></i>
                </div>
                <div class="stat-mini-info">
                    @if (Model.ClassStats != null && Model.ClassStats.AverageClassScore > 0)
                    {
                        <span class="stat-mini-metric">@Model.ClassStats.AverageClassScore.ToString("F2") / 10</span>
                        <span class="stat-mini-title">Điểm TB Lớp</span>
                    }
                    else
                    {
                        <span class="stat-mini-metric">Chưa chấm</span>
                        <span class="stat-mini-title">Điểm TB Lớp</span>
                    }
                </div>
            </div>

            <div class="stat-mini-card">
                <div class="stat-mini-icon-box icon-pink">
                    <i class="bi bi-fire"></i>
                </div>
                <div class="stat-mini-info">
                    @if (Model.ClassStats?.HardestQuestions != null && Model.ClassStats.HardestQuestions.Count > 0)
                    {
                        var hardest = Model.ClassStats.HardestQuestions[0];
                        <span class="stat-mini-metric">@hardest.QuestionId</span>
                        <span class="stat-mini-title">@(string.IsNullOrWhiteSpace(hardest.QuestionTitle) ? hardest.CognitiveLevel : hardest.QuestionTitle)</span>
                    }
                    else
                    {
                        <span class="stat-mini-metric">Chưa có dữ liệu</span>
                        <span class="stat-mini-title">Câu khó nhất</span>
                    }
                </div>
            </div>
        </div>

        <!-- 2.5. Tiêu chí chấm điểm theo Rubric từ khóa (nguồn: RubricCatalog trong BLL) -->
        <div class="viva-panel-card p-4 mb-4 border-0 shadow-sm" style="background: #ffffff; border-radius: 18px; border: 1px solid #e2e8f0;">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge rounded-pill px-3 py-1 text-white" style="background: #0f766e;">
                            <i class="bi bi-card-checklist me-1"></i> RUBRIC
                        </span>
                        <span class="badge tag-purple">BỘ TIÊU CHÍ KHẢO THÍ ĐỀ @defaultExam</span>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark">Tiêu chí Chấm điểm Vấn đáp theo Rubric</h5>
                    <p class="text-secondary small mb-0">Transcript câu trả lời được so khớp với nhóm từ khóa của từng tiêu chí. Điểm câu = tổng trọng số tiêu chí đạt quy về thang 10.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-white text-secondary border rounded-pill px-3 py-2 fw-semibold" title="Mức demo, không phải chấm AI nâng cao (Nhóm 4)">
                        <i class="bi bi-info-circle me-1"></i> Chấm tự động theo Rubric từ khóa
                    </span>
                </div>
            </div>

            @if (Model.Rubrics.Count == 0)
            {
                <p class="text-muted small mb-0">Chưa có Rubric cho đề @defaultExam.</p>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var rubric in Model.Rubrics)
                    {
                        <div class="col-lg-4">
                            <div class="p-3 rounded-4 h-100" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="badge tag-purple fw-bold">@rubric.QuestionId</span>
                                    <span class="badge bg-white text-dark border">Thang điểm: @rubric.MaxScore.ToString("0.#")</span>
                                </div>
                                <h6 class="fw-bold text-dark mb-2">@rubric.Title</h6>
                                <div class="small text-secondary mb-3">Các ý trọng tâm được chấm:</div>
                                <ul class="list-unstyled small mb-0 vstack gap-2">
                                    @for (var i = 0; i < rubric.Criteria.Count; i++)
                                    {
                                        var criterion = rubric.Criteria[i];
                                        <li class="d-flex align-items-start gap-2">
                                            <i class="bi bi-dot text-primary"></i>
                                            <span><strong>Ý @(i + 1) (@rubric.PointsFor(criterion).ToString("0.#")đ):</strong> @criterion.Description</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- 3. Các lớp học phần phụ trách -->
        <div class="section-header">
            <h2 class="section-title">Lớp học phần phụ trách</h2>
            <span class="badge tag-cyan">Học kỳ Fall 2026</span>
        </div>

        <div class="course-cards-grid">
            @if (Model.AvailableClasses.Count == 0)
            {
                <div class="p-4 text-center text-muted w-100">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    <span>Chưa có dữ liệu lớp học</span>
                </div>
            }
            else
            {
                @foreach (var c in Model.AvailableClasses)
                {
                    <div class="course-card">
                        <div class="course-card-thumb-wrap p-4 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #0d9488 0%, #14b8a6 100%); min-height: 140px;">
                            <i class="bi bi-mortarboard-fill text-white" style="font-size: 3rem;"></i>
                        </div>
                        <div class="course-card-body">
                            <span class="course-tag-pill tag-cyan">LỚP @c</span>
                            <h3 class="course-card-title">Học phần Khảo thí Viva</h3>
                            <div class="mt-auto pt-2">
                                <a href="/ClassReports?classId=@Uri.EscapeDataString(c)" class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-bold">
                                    <i class="bi bi-bar-chart-fill me-1"></i> Xem thống kê lớp
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- 4. Danh sách sinh viên vừa nộp bài cần duyệt -->
        <div class="section-header">
            <h2 class="section-title">Sinh viên hoàn thành bài thi vấn đáp</h2>
            <a href="/ClassReports" class="section-link">Xem tất cả lớp</a>
        </div>

        <div class="lesson-table-wrap">
            @if (Model.ClassStats?.GradeExportRows == null || Model.ClassStats.GradeExportRows.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    <span>Chưa có dữ liệu bài thi</span>
                </div>
            }
            else
            {
                <table class="lesson-table">
                    <thead>
                        <tr>
                            <th>SINH VIÊN</th>
                            <th>MÔN THI</th>
                            <th>ĐIỂM SỐ</th>
                            <th>KẾT QUẢ</th>
                            <th style="text-align: right;">XEM BÀI THI</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.ClassStats.GradeExportRows)
                        {
                            <tr>
                                <td>
                                    <div class="table-mentor-cell">
                                        <div class="brand-icon-box" style="width: 34px; height: 34px; font-size: 16px; border-radius: 10px;">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <div class="table-mentor-name">@row.StudentName</div>
                                            <div class="table-mentor-date">MSSV: @row.StudentId · Lớp: @row.ClassId</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge tag-purple m-0">@defaultExam</span></td>
                                <td><strong class="fs-6">@row.AverageScore</strong></td>
                                <td>
                                    @if (row.ResultStatus.Contains("Đạt", StringComparison.OrdinalIgnoreCase) && !row.ResultStatus.Contains("Chưa", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success text-white rounded-pill px-3">@row.ResultStatus</span>
                                    }
                                    else if (row.ResultStatus.Contains("Chưa chấm", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-secondary text-white rounded-pill px-3">Chưa chấm</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-white rounded-pill px-3">@row.ResultStatus</span>
                                    }
                                </td>
                                <td style="text-align: right;">
                                    <a href="/ClassReports/StudentDetail?studentId=@Uri.EscapeDataString(row.StudentId)&amp;classId=@Uri.EscapeDataString(row.ClassId)&amp;examId=@Uri.EscapeDataString(defaultExam)" class="table-action-btn" title="Xem chi tiết"><i class="bi bi-arrow-up-right"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- Right Statistic Column -->
    <div class="dashboard-side-col">
        <div class="statistic-panel">
            <div class="statistic-header">
                <h3 class="statistic-title">Class Progress</h3>
                <button type="button" class="statistic-more-btn"><i class="bi bi-three-dots-vertical"></i></button>
            </div>

            <div class="statistic-user-card">
                <div class="avatar-progress-container">
                    <div class="avatar-progress-ring" style="background: conic-gradient(#0d9488 0% 100%, #e2e8f0 100%);">
                        <div class="avatar-progress-inner">
                            <div class="brand-icon-box" style="width: 76px; height: 76px; font-size: 32px; border-radius: 50%;">
                                <i class="bi bi-person-check-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="statistic-user-greeting">Xin chào, @userName 🔥</div>
                <div class="statistic-user-sub">Lớp @defaultClass · Đề @defaultExam</div>
            </div>

            <!-- Mini Bar Chart -->
            <div class="chart-card">
                <div class="chart-bars-wrap">
                    @if (Model.ClassStats?.ScoreDistribution != null && Model.ClassStats.ScoreDistribution.Count > 0)
                    {
                        var maxCount = Model.ClassStats.ScoreDistribution.Max(b => b.StudentCount);
                        @foreach (var bin in Model.ClassStats.ScoreDistribution)
                        {
                            var h = maxCount > 0 ? Math.Max(15, (int)(bin.StudentCount * 100.0 / maxCount)) : 20;
                            <div class="chart-bar-col"><div class="chart-bar-pillar" style="height: @(h)%; background: #0d9488;"></div></div>
                        }
                    }
                    else
                    {
                        <div class="chart-bar-col"><div class="chart-bar-pillar" style="height: 35%; background: #99f6e4;"></div></div>
                        <div class="chart-bar-col"><div class="chart-bar-pillar" style="height: 60%; background: #5eead4;"></div></div>
                        <div class="chart-bar-col"><div class="chart-bar-pillar" style="height: 90%; background: #0d9488;"></div></div>
                        <div class="chart-bar-col"><div class="chart-bar-pillar" style="height: 70%; background: #2dd4bf;"></div></div>
                    }
                </div>
                <div class="chart-axis-labels">
                    <span>Điểm 0-4</span>
                    <span>Điểm 5-6</span>
                    <span>Điểm 7-8</span>
                    <span>Điểm 9-10</span>
                </div>
            </div>

            <!-- Hardest Question Card -->
            <div class="p-3 rounded-4" style="background: #fff1f2; border: 1px solid #fecdd3;">
                <div class="d-flex align-items-center gap-2 mb-1 text-danger fw-bold small">
                    <i class="bi bi-fire"></i> CÂU HỎI CẦN LƯU Ý
                </div>
                @if (Model.ClassStats?.HardestQuestions != null && Model.ClassStats.HardestQuestions.Count > 0)
                {
                    var hardest = Model.ClassStats.HardestQuestions[0];
                    <div class="fw-bold text-dark small mb-1">@hardest.QuestionId: @hardest.QuestionTitle</div>
                    <div class="text-secondary small">Tỉ lệ chưa đạt: @hardest.FailRate.ToString("F1")%</div>
                }
                else
                {
                    <div class="text-secondary small">Chưa có dữ liệu câu hỏi</div>
                }
            </div>

            <a href="/ClassReports" class="btn-see-all-mentors" style="background: #ccfbf1; color: #0f766e;">
                Xem toàn bộ phổ điểm lớp
            </a>
        </div>
    </div>
</div>
