@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using AIVES.BLL.Security
@{
    var roleClaimValue = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
    var friendlyRole = roleClaimValue switch
    {
        ApplicationRoles.Admin => "Quản trị viên",
        ApplicationRoles.Lecturer => "Giảng viên",
        ApplicationRoles.Staff => "Sinh viên",
        _ => "Thí sinh"
    };
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString();
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var isAuth = User.Identity?.IsAuthenticated == true;

    bool isAdminDashboardActive =
        (string.Equals(currentCtrl, "Account", StringComparison.OrdinalIgnoreCase) &&
         (string.Equals(currentAct, "AdminDashboard", StringComparison.OrdinalIgnoreCase) ||
          string.Equals(currentAct, "Dashboard", StringComparison.OrdinalIgnoreCase))) ||
        string.Equals(currentPage, "/Account/AdminDashboard", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentPage, "/Account/Dashboard", StringComparison.OrdinalIgnoreCase);

    bool isAccountIndexActive =
        (string.Equals(currentCtrl, "Account", StringComparison.OrdinalIgnoreCase) &&
         string.Equals(currentAct, "Index", StringComparison.OrdinalIgnoreCase)) ||
        string.Equals(currentPage, "/Account/Index", StringComparison.OrdinalIgnoreCase);

    bool isLecturerDashboardActive =
        (string.Equals(currentCtrl, "Account", StringComparison.OrdinalIgnoreCase) &&
         (string.Equals(currentAct, "LecturerDashboard", StringComparison.OrdinalIgnoreCase) ||
          string.Equals(currentAct, "Dashboard", StringComparison.OrdinalIgnoreCase))) ||
        string.Equals(currentPage, "/Account/LecturerDashboard", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentPage, "/Account/Dashboard", StringComparison.OrdinalIgnoreCase);

    bool isStudentDashboardActive =
        (string.Equals(currentCtrl, "Account", StringComparison.OrdinalIgnoreCase) &&
         (string.Equals(currentAct, "StudentDashboard", StringComparison.OrdinalIgnoreCase) ||
          string.Equals(currentAct, "Dashboard", StringComparison.OrdinalIgnoreCase))) ||
        string.Equals(currentPage, "/Account/StudentDashboard", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentPage, "/Account/Dashboard", StringComparison.OrdinalIgnoreCase);

    bool isClassReportsActive =
        string.Equals(currentCtrl, "ClassReports", StringComparison.OrdinalIgnoreCase) ||
        (currentPage != null && currentPage.StartsWith("/ClassReports", StringComparison.OrdinalIgnoreCase));

    bool isStudentReportsActive =
        string.Equals(currentCtrl, "StudentReports", StringComparison.OrdinalIgnoreCase) ||
        (currentPage != null && currentPage.StartsWith("/StudentReports", StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AIVES Viva Exam</title>
    <!-- Modern Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (isAuth)
    {
        <div class="app-shell">
            <div class="app-frame">
                <!-- 1. LEFT SIDEBAR (Identical to reference screenshot) -->
                <aside class="app-sidebar" id="appSidebar">
                    <div>
                        <!-- Logo & Brand Header -->
                        <a href="/Account/Dashboard" class="brand-header">
                            <div class="brand-icon-box">
                                <i class="bi bi-stars"></i>
                            </div>
                            <span class="brand-title">AIVES</span>
                        </a>

                        <!-- Category: ROLE-DEDICATED NAVIGATION -->
                        @if (User.IsInRole(ApplicationRoles.Admin))
                        {
                            <div class="sidebar-category">QUẢN TRỊ VIÊN</div>
                            <ul class="sidebar-nav-list">
                                <li class="sidebar-nav-item @(isAdminDashboardActive ? "active" : "")">
                                    <a href="/Account/AdminDashboard">
                                        <i class="bi bi-grid-fill"></i>
                                        <span>Dashboard Admin</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(isAccountIndexActive ? "active" : "")">
                                    <a href="/Account/Index">
                                        <i class="bi bi-people-fill"></i>
                                        <span>Quản lý Tài khoản</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(isClassReportsActive ? "active" : "")">
                                    <a href="/ClassReports">
                                        <i class="bi bi-bar-chart-steps"></i>
                                        <span>Báo cáo Học vụ</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(currentPage != null && currentPage.StartsWith("/Viva", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-page="/Viva/Index">
                                        <i class="bi bi-mic-fill"></i>
                                        <span>Thử nghiệm Viva</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(currentPage != null && currentPage.StartsWith("/Admin/AiSettings", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-page="/Admin/AiSettings">
                                        <i class="bi bi-robot"></i>
                                        <span>Cấu hình AI</span>
                                    </a>
                                </li>
                            </ul>
                        }
                        else if (User.IsInRole(ApplicationRoles.Lecturer))
                        {
                            <div class="sidebar-category">GIẢNG VIÊN</div>
                            <ul class="sidebar-nav-list">
                                <li class="sidebar-nav-item @(isLecturerDashboardActive ? "active" : "")">
                                    <a href="/Account/LecturerDashboard">
                                        <i class="bi bi-grid-fill"></i>
                                        <span>Dashboard Giảng viên</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(isClassReportsActive ? "active" : "")">
                                    <a href="/ClassReports">
                                        <i class="bi bi-bar-chart-steps"></i>
                                        <span>Thống kê Lớp học</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(currentPage != null && currentPage.StartsWith("/Viva", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-page="/Viva/Index">
                                        <i class="bi bi-camera-video-fill"></i>
                                        <span>Phòng thi Viva</span>
                                    </a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <div class="sidebar-category">SINH VIÊN</div>
                            <ul class="sidebar-nav-list">
                                <li class="sidebar-nav-item @(isStudentDashboardActive ? "active" : "")">
                                    <a href="/Account/StudentDashboard">
                                        <i class="bi bi-grid-fill"></i>
                                        <span>Dashboard Sinh viên</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(currentPage != null && currentPage.StartsWith("/Viva", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-page="/Viva/Index">
                                        <i class="bi bi-camera-video-fill"></i>
                                        <span>Phòng thi Viva</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(isStudentReportsActive ? "active" : "")">
                                    <a href="/StudentReports">
                                        <i class="bi bi-journal-check"></i>
                                        <span>Báo cáo cá nhân</span>
                                    </a>
                                </li>
                            </ul>
                        }
                    </div>
                </aside>

                <!-- 2. MAIN WORKSPACE AREA -->
                <div class="app-main">
                    <!-- Topbar Header -->
                    <header class="app-topbar">
                        <!-- Mobile Sidebar Toggle Button -->
                        <button type="button" class="sidebar-toggler me-3" id="sidebarToggler" aria-label="Toggle menu">
                            <i class="bi bi-list"></i>
                        </button>

                        <!-- Search Bar -->
                        <div class="topbar-search-box">
                            <i class="bi bi-search topbar-search-icon"></i>
                            <input type="text" class="topbar-search-input" placeholder="Tìm kiếm bài thi, môn học, câu hỏi..." />
                        </div>

                        <!-- Action Icons & User Profile -->
                        <div class="topbar-actions">
                            <button type="button" class="topbar-circle-btn" title="Tin nhắn">
                                <i class="bi bi-envelope"></i>
                            </button>
                            <button type="button" class="topbar-circle-btn" title="Thông báo">
                                <i class="bi bi-bell"></i>
                                <span class="topbar-badge-dot"></span>
                            </button>

                            <!-- Profile avatar dropdown -->
                            <div class="dropdown">
                                <button type="button" class="topbar-user-profile" id="userProfileDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Menu tài khoản">
                                    <div class="topbar-user-avatar bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; border-radius: 50%;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <div class="d-none d-md-block text-start">
                                        <div class="topbar-user-name">@(User.Identity?.Name ?? "Người dùng")</div>
                                        <div class="topbar-user-role">@friendlyRole</div>
                                    </div>
                                    <i class="bi bi-chevron-down topbar-user-chevron ms-1"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end topbar-user-dropdown shadow-sm" aria-labelledby="userProfileDropdown">
                                    <li class="topbar-dropdown-header px-3 py-2">
                                        <div class="fw-bold text-dark text-truncate">@(User.Identity?.Name ?? "Người dùng")</div>
                                        <div class="small text-muted">@friendlyRole</div>
                                    </li>
                                    <li><hr class="dropdown-divider my-1" /></li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="/Account/Dashboard">
                                            <i class="bi bi-gear text-secondary"></i>
                                            <span>Cài đặt</span>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1" /></li>
                                    <li>
                                        <form action="/Account/Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger">
                                                <i class="bi bi-box-arrow-right"></i>
                                                <span>Đăng xuất</span>
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </header>

                    <!-- Page Body Contents -->
                    <main class="app-body">
                        @if (TempData["SuccessMessage"] is string successMessage)
                        {
                            <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="status">
                                <i class="bi bi-check-circle-fill me-2 text-success"></i> @successMessage
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                            </div>
                        }
                        @if (TempData["ErrorMessage"] is string errorMessage)
                        {
                            <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @errorMessage
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                            </div>
                        }

                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Unauthenticated Layout (Centered modern card) -->
        <div class="app-shell align-items-center justify-content-center">
            <div class="p-3 w-100" style="max-width: 480px;">
                @RenderBody()
            </div>
        </div>
    }

    <!-- Nơi render Popup Modal động -->
    <div id="modalContainer" aria-live="polite"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Toggle mobile sidebar
        const toggler = document.getElementById('sidebarToggler');
        const sidebar = document.getElementById('appSidebar');
        if (toggler && sidebar) {
            toggler.addEventListener('click', () => {
                sidebar.classList.toggle('d-block');
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>