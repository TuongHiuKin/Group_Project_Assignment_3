@using AIVES.BLL.Security
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AIVES AI Viva Examination</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .viva-header {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border-bottom: 2px solid #3b82f6;
        }
        .viva-badge-pulse {
            animation: vivaPulse 2s infinite;
        }
        @@keyframes vivaPulse {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.05); opacity: 0.85; }
            100% { transform: scale(1); opacity: 1; }
        }
        .viva-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
            transition: all 0.25s ease-in-out;
        }
        .viva-card:hover {
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.1);
        }
        .viva-timer-box {
            font-family: 'Courier New', Courier, monospace;
            font-size: 2.2rem;
            font-weight: 700;
            letter-spacing: 2px;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100 bg-light text-dark">
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-dark viva-header shadow-sm py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-page="/Viva/Index">
                    <span class="badge bg-primary p-2 me-2 rounded-circle">
                        <i class="bi bi-robot fs-5"></i>
                    </span>
                    <div>
                        <span class="text-white text-uppercase tracking-wider">AIVES Viva Room</span>
                        <small class="d-block text-info fs-7 fw-normal">Hệ thống phỏng vấn vấn đáp AI</small>
                    </div>
                </a>

                <div class="d-flex align-items-center gap-3 ms-auto">
                    <!-- SignalR connection badge -->
                    <span id="connectionBadge" class="badge bg-secondary py-2 px-3 rounded-pill d-inline-flex align-items-center">
                        <i class="bi bi-circle-fill text-muted me-1 fs-8"></i>
                        <span id="connectionBadgeText">Chưa kết nối</span>
                    </span>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var roleClaim = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
                        var friendlyRole = roleClaim switch
                        {
                            ApplicationRoles.Admin => "Quản trị viên",
                            ApplicationRoles.Lecturer => "Giảng viên",
                            ApplicationRoles.Staff => "Sinh viên",
                            _ => roleClaim ?? "Thí sinh"
                        };

                        <span class="badge bg-dark border border-secondary text-light py-2 px-3 rounded-pill d-none d-md-inline-flex align-items-center">
                            <i class="bi bi-person-badge text-warning me-1"></i>
                            <span>@User.Identity.Name</span>
                            <span class="ms-1 text-info fw-semibold">(@friendlyRole)</span>
                        </span>

                        <button type="button" class="btn btn-outline-light btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#leaveRoomModal" id="btnLeaveRoom">
                            <i class="bi bi-box-arrow-left me-1"></i> Rời phòng
                        </button>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 container-fluid px-3 px-md-4 py-3">
        @RenderBody()
    </main>

    <!-- Modal Xác nhận rời phòng thi -->
    <div class="modal fade" id="leaveRoomModal" tabindex="-1" aria-labelledby="leaveRoomModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="leaveRoomModalLabel">
                        <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                        Xác nhận rời phòng thi
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body py-3 text-secondary">
                    <p class="mb-2">Bạn có chắc chắn muốn rời khỏi phòng thi vấn đáp?</p>
                    <div class="alert alert-info py-2 px-3 small rounded-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Tiến trình thi của bạn đã được hệ thống lưu trữ an toàn. Bạn có thể quay lại phòng thi bất kỳ lúc nào bằng mã phiên thi hiện tại.
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Ở lại phòng</button>
                    <a href="/Account/Dashboard" class="btn btn-danger rounded-pill px-4" id="btnConfirmLeaveRoom">
                        <i class="bi bi-box-arrow-left me-1"></i> Rời phòng
                    </a>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-white border-top py-2 text-center text-muted small mt-auto">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center flex-wrap">
            <span>&copy; @DateTime.UtcNow.Year AIVES — AI Viva Examination System. All rights reserved.</span>
            <span><i class="bi bi-shield-check text-success me-1"></i>Phiên bảo mật &bull; Group 3 Viva Core</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        document.getElementById('btnConfirmLeaveRoom')?.addEventListener('click', async function (e) {
            e.preventDefault();
            const targetUrl = this.getAttribute('href') || '/Account/Dashboard';
            if (window.vivaExamClient && typeof window.vivaExamClient.leaveSession === 'function') {
                try {
                    await window.vivaExamClient.leaveSession();
                } catch (err) {
                    console.warn('Error during leaveSession:', err);
                }
            }
            window.location.href = targetUrl;
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
