@model AIVES.BLL.Models.ExamReporting.QuestionResultDto
@{
    var evalMode = ViewData["EvaluationMode"] as AIVES.BLL.Models.ExamReporting.ExamEvaluationMode? 
                   ?? Model.EvaluationMode;
    bool isPassFailMode = evalMode == AIVES.BLL.Models.ExamReporting.ExamEvaluationMode.PassFail;

    // Nhận xét chi tiết của AI (AiFeedback, Strengths, Weaknesses) là tài liệu làm việc nội bộ
    // của giảng viên: nó nói thẳng chỗ sinh viên hiểu sai, dùng để GV đối chiếu khi duyệt điểm.
    // Trang báo cáo cá nhân của sinh viên đặt cờ này để ẩn đi; trang của giảng viên
    // (ClassReports/StudentDetail) không đặt nên vẫn thấy đầy đủ.
    bool hideAiFeedback = ViewData["HideAiFeedback"] as bool? ?? false;
}

<div class="aives-q-card">
    <!-- KHỐI 1: Nội dung Câu hỏi chính (kèm Bloom level, mã câu hỏi) -->
    <div class="aives-q-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="badge tag-purple fs-6">
                <i class="bi bi-question-circle-fill me-1"></i> Câu @Model.QuestionId
            </span>
            <span class="badge tag-cyan">
                <i class="bi bi-diagram-3-fill me-1"></i>Thang Bloom: @Model.CognitiveLevel
            </span>
        </div>
        <div class="text-muted small fw-semibold">
            <i class="bi bi-mortarboard me-1"></i>Khối 1: Câu hỏi chính
        </div>
    </div>

    <div class="p-4">
        <!-- Nội dung câu hỏi chính -->
        <div class="mb-4">
            <h5 class="fw-bold text-dark mb-0 lh-base" style="font-size: 1.15rem;">
                @Model.QuestionTitle
            </h5>
        </div>

        <!-- KHỐI 2: Câu trả lời của thí sinh & Transcript đào sâu của AI (Adaptive Follow-up) -->
        <div class="mb-4">
            <div class="aives-block-heading">
                <span class="aives-block-badge-num">2</span>
                <span>Câu trả lời của thí sinh & Transcript đào sâu của AI</span>
            </div>

            <div class="aives-transcript-flow">
                <!-- 2.1 Câu trả lời chính -->
                <div class="aives-answer-box mb-3">
                    <div class="small fw-bold text-primary mb-1 d-flex align-items-center gap-1">
                        <i class="bi bi-person-fill"></i> Câu trả lời chính:
                    </div>
                    <p class="mb-0 text-dark fst-italic lh-base">
                        @(string.IsNullOrWhiteSpace(Model.StudentInitialAnswerTranscript) 
                            ? "Chưa có bản ghi âm câu trả lời chính." 
                            : $"\"{Model.StudentInitialAnswerTranscript}\"")
                    </p>
                </div>

                <!-- 2.2 Câu hỏi xoáy của AI + câu trả lời xoáy -->
                @if (!string.IsNullOrWhiteSpace(Model.AiFollowUpQuestion))
                {
                    <div class="aives-followup-box mb-3">
                        <div class="small fw-bold text-danger mb-1 d-flex align-items-center gap-1">
                            <i class="bi bi-robot"></i> Câu hỏi xoáy (AI sinh ra từ câu trả lời trên):
                        </div>
                        <p class="mb-0 text-dark fw-bold lh-base">
                            @Model.AiFollowUpQuestion
                        </p>
                    </div>

                    <!-- 2.3 Câu trả lời xoáy -->
                    <div class="aives-followup-answer-box">
                        <div class="small fw-bold text-success mb-1 d-flex align-items-center gap-1">
                            <i class="bi bi-person-check-fill"></i> Câu trả lời xoáy:
                        </div>
                        <p class="mb-0 text-dark fst-italic lh-base">
                            @(string.IsNullOrWhiteSpace(Model.StudentFollowUpAnswerTranscript) 
                                ? "Chưa có bản ghi câu trả lời xoáy." 
                                : $"\"{Model.StudentFollowUpAnswerTranscript}\"")
                        </p>
                    </div>
                }
                else
                {
                    <div class="aives-followup-box" style="background: #f8fafc; border-left-color: #cbd5e1;">
                        <div class="small fw-bold text-secondary mb-1 d-flex align-items-center gap-1">
                            <i class="bi bi-dash-circle"></i> Không có câu hỏi xoáy:
                        </div>
                        <p class="mb-0 text-secondary small lh-base">
                            Câu trả lời chính không đạt điều kiện để AI đặt câu hỏi xoáy (câu trả lời rỗng, quá ngắn, lạc đề hoặc chỉ gồm câu đệm).
                        </p>
                    </div>
                }
            </div>
        </div>

        <!-- KHỐI 3: Ghi chú / Nhận xét của Giảng viên (Human-in-the-loop) -->
        <div class="mb-4">
            <div class="aives-block-heading">
                <span class="aives-block-badge-num">3</span>
                <span>Ghi chú / Nhận xét của Giảng viên (Human-in-the-loop)</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.TeacherNotes))
            {
                <div class="aives-teacher-notes-box">
                    <div class="d-flex align-items-start gap-3">
                        <div class="brand-icon-box" style="width: 36px; height: 36px; font-size: 16px; border-radius: 10px;">
                            <i class="bi bi-person-workspace"></i>
                        </div>
                        <div>
                            <strong class="d-block mb-1 text-primary">Nhận xét từ Giảng viên phụ trách:</strong>
                            <p class="mb-0 text-dark fw-medium lh-base">@Model.TeacherNotes</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="p-3 rounded-4 bg-light text-muted small border">
                    <i class="bi bi-info-circle me-1"></i>
                    <em>Chưa có ghi chú bổ sung từ giảng viên cho câu hỏi này.</em>
                </div>
            }
        </div>

        <!-- KHỐI 4: Đánh giá chi tiết của AI & Kết quả -->
        <div class="mb-4">
            <div class="aives-block-heading">
                <span class="aives-block-badge-num">4</span>
                <span>Đánh giá chi tiết & Điểm số đạt được</span>
                @if (Model.IsFinalized)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle ms-2 fw-semibold">
                        <i class="bi bi-shield-check me-1"></i>Điểm chính thức
                    </span>
                }
                else if (Model.IsAiGraded)
                {
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-2 fw-semibold">
                        <i class="bi bi-robot me-1"></i>AI chấm, chờ giảng viên duyệt
                    </span>
                }
            </div>

            <!-- Thanh Huy hiệu Điểm số & Trạng thái -->
            <div class="mb-3 d-flex flex-wrap align-items-center justify-content-between gap-2 p-3 rounded-4 bg-light border">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    @if (Model.GradingState == AIVES.BLL.Models.ExamReporting.ReportGradingState.Pending)
                    {
                        <span class="badge tag-pink px-3 py-2 fs-6">
                            <i class="bi bi-hourglass-split me-1"></i>Chưa chấm (Đang chờ chấm điểm)
                        </span>
                    }
                    else
                    {
                        @if (Model.IsFinalized)
                        {
                            <span class="badge bg-success text-white px-3 py-2 fs-6 fw-bold rounded-pill">
                                <i class="bi bi-shield-check me-1"></i> ĐIỂM CHÍNH THỨC
                            </span>
                        }
                        else if (Model.IsAiGraded)
                        {
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6 fw-bold rounded-pill">
                                <i class="bi bi-robot me-1"></i> AI CHẤM, CHỜ DUYỆT
                            </span>
                        }

                        @if (Model.IsPassed)
                        {
                            <span class="badge bg-success text-white px-3 py-2 fs-6 fw-bold rounded-pill">
                                <i class="bi bi-check-circle-fill me-1"></i> ĐẠT CHUẨN
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger text-white px-3 py-2 fs-6 fw-bold rounded-pill">
                                <i class="bi bi-x-circle-fill me-1"></i> CHƯA ĐẠT
                            </span>
                        }

                        @if (isPassFailMode)
                        {
                            <span class="badge tag-cyan rounded-pill px-3 py-2">
                                <i class="bi bi-shield-check me-1"></i>Chế độ Pass/Fail
                            </span>
                        }
                    }
                </div>

                @if (Model.GradingState == AIVES.BLL.Models.ExamReporting.ReportGradingState.Pending)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-2 fs-6 fw-bold">
                            <i class="bi bi-award me-1"></i>Điểm: Chưa chấm
                        </span>
                    </div>
                }
                else if (!isPassFailMode)
                {
                    @* Sinh viên chỉ thấy MỘT con số tại một thời điểm:
                       - AI chấm xong, GV chưa duyệt  → điểm AI kèm nhãn "chờ giảng viên duyệt".
                       - GV đã chốt                     → CHỈ điểm GV, không hiện lại điểm AI.
                       Việc AI đề xuất bao nhiêu và GV sửa bao nhiêu là thông tin nội bộ của
                       giảng viên, hiển thị ở trang Review/ClassReports chứ không đưa cho sinh viên
                       (tránh sinh viên so sánh rồi thắc mắc điểm bị hạ). *@
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        @if (Model.IsFinalized)
                        {
                            var teacherScore = Model.TeacherFinalScore;

                            <span class="badge bg-success text-white rounded-pill px-3 py-2 fs-6 fw-bold"
                                  title="Điểm chính thức do giảng viên chốt">
                                <i class="bi bi-patch-check-fill me-1"></i>Điểm chính thức: @teacherScore.ToString("0.##") / @Model.MaxScore.ToString("0.##")
                            </span>
                        }
                        else if (Model.IsAiGraded)
                        {
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fs-6 fw-bold" title="Điểm do AI chấm tạm thời, đang chờ giảng viên duyệt">
                                <i class="bi bi-robot me-1"></i>AI chấm, chờ giảng viên duyệt: @Model.EarnedScore.ToString("0.##") / @Model.MaxScore.ToString("0.##")
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary text-white rounded-pill px-3 py-2 fs-6 fw-bold" title="Điểm đạt được">
                                <i class="bi bi-award-fill me-1"></i>Điểm: @Model.EarnedScore.ToString("0.##") / @Model.MaxScore.ToString("0.##")
                            </span>
                        }
                    </div>
                }
            </div>

            @* Nhận xét chi tiết của AI — chỉ giảng viên thấy *@
            @if (!hideAiFeedback && !string.IsNullOrWhiteSpace(Model.AiFeedback))
            {
                <div class="aives-feedback-box mb-3">
                    <div class="fw-bold text-dark mb-1 d-flex align-items-center gap-1">
                        <i class="bi bi-chat-square-dots-fill text-primary"></i> Nhận xét của AI:
                    </div>
                    <p class="mb-0 text-dark lh-base">@Model.AiFeedback</p>
                </div>
            }

            @* Điểm mạnh & Điểm cần cải thiện — cùng lý do, ẩn với sinh viên *@
            @if (!hideAiFeedback)
            {
            <div class="row g-3">
                @if (!string.IsNullOrWhiteSpace(Model.Strengths))
                {
                    <div class="@(string.IsNullOrWhiteSpace(Model.Weaknesses) ? "col-12" : "col-md-6")">
                        <div class="p-3 rounded-4" style="background: #f0fdf4; border: 1px solid #bbf7d0;">
                            <div class="fw-bold mb-1 text-success d-flex align-items-center gap-1">
                                <i class="bi bi-hand-thumbs-up-fill"></i> Điểm mạnh đạt được:
                            </div>
                            <div class="text-dark lh-base small">@Model.Strengths</div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Weaknesses))
                {
                    <div class="@(string.IsNullOrWhiteSpace(Model.Strengths) ? "col-12" : "col-md-6")">
                        <div class="p-3 rounded-4" style="background: #fff1f2; border: 1px solid #fecdd3;">
                            <div class="fw-bold mb-1 text-danger d-flex align-items-center gap-1">
                                <i class="bi bi-exclamation-triangle-fill"></i> Điểm cần cải thiện & Ý còn thiếu:
                            </div>
                            <div class="text-dark lh-base small">@Model.Weaknesses</div>
                        </div>
                    </div>
                }
            </div>
            }
        </div>

        <!-- KHỐI 5: Tiêu chí Rubric chi tiết & Chuẩn đầu ra -->
        <div>
            <div class="aives-block-heading">
                <span class="aives-block-badge-num">5</span>
                <span>Tiêu chí Rubric chi tiết & Chuẩn đầu ra</span>
            </div>

            <div class="p-3 rounded-4 bg-light border">
                <div class="d-flex flex-wrap align-items-center gap-3 mb-2 pb-2 border-bottom">
                    @if (isPassFailMode)
                    {
                        <div>
                            <span class="text-secondary small fw-semibold">Hình thức đánh giá:</span>
                            <span class="badge bg-white text-dark border ms-1 rounded-pill">Đạt / Không đạt (Pass/Fail)</span>
                        </div>
                        <div>
                            <span class="text-secondary small fw-semibold">Quy tắc chuẩn:</span>
                            <span class="badge bg-white text-dark border ms-1 rounded-pill">Tỷ lệ đạt tối thiểu (DEC-04)</span>
                        </div>
                    }
                    else
                    {
                        <div>
                            <span class="text-secondary small fw-semibold">Điểm tối đa:</span>
                            <span class="badge tag-purple ms-1 fw-bold">@Model.MaxScore điểm</span>
                        </div>
                        <div>
                            <span class="text-secondary small fw-semibold">Ngưỡng đạt Rubric:</span>
                            <span class="badge tag-cyan ms-1">@Model.PassThresholdScore.ToString("0.#") điểm (DEC-03)</span>
                        </div>
                    }
                </div>

                @if (Model.RubricDetails != null && Model.RubricDetails.Any())
                {
                    <div class="mb-3">
                        <span class="text-secondary small fw-semibold d-block mb-2">
                            <i class="bi bi-list-columns-reverse me-1 text-primary"></i> Bảng tiêu chí Rubric chi tiết:
                        </span>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0 bg-white rounded-3 overflow-hidden">
                                <thead class="table-light">
                                    <tr class="small text-uppercase text-secondary">
                                        <th scope="col" style="width:90px;">Mã</th>
                                        <th scope="col">Tiêu chí</th>
                                        <th scope="col" class="text-center" style="width:110px;">Kết quả</th>
                                        <th scope="col" class="text-center" style="width:110px;">Điểm</th>
                                        <th scope="col">Giải thích / Từ khoá khớp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.RubricDetails)
                                    {
                                        <tr>
                                            <td><span class="badge tag-purple">@c.CriterionCode</span></td>
                                            <td class="small fw-medium text-dark">@c.CriterionName</td>
                                            <td class="text-center">
                                                @if (c.IsMet)
                                                {
                                                    <span class="badge bg-success text-white rounded-pill"><i class="bi bi-check2 me-1"></i>Đạt</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger text-white rounded-pill"><i class="bi bi-x me-1"></i>Chưa đạt</span>
                                                }
                                            </td>
                                            <td class="text-center small fw-bold text-dark">
                                                @(c.MaxPoints > 0 ? $"{c.AwardedPoints:0.#} / {c.MaxPoints:0.#}" : "—")
                                            </td>
                                            <td class="small text-muted">@(string.IsNullOrWhiteSpace(c.Explanation) ? "—" : c.Explanation)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else if (Model.CriteriaOutcomes != null && Model.CriteriaOutcomes.Any())
                {
                    <div class="mb-3">
                        <span class="text-secondary small fw-semibold d-block mb-2">Kết quả kiểm tra tiêu chí:</span>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var criterion in Model.CriteriaOutcomes)
                            {
                                <span class="badge @(criterion.Value ? "bg-success text-white" : "bg-danger text-white") py-1.5 px-3 rounded-pill">
                                    <i class="bi @(criterion.Value ? "bi-check2" : "bi-x") me-1"></i>
                                    @criterion.Key: <strong>@(criterion.Value ? "ĐẠT" : "CHƯA ĐẠT")</strong>
                                </span>
                            }
                        </div>
                    </div>
                }

                <div>
                    <span class="text-secondary small fw-semibold d-block mb-1">
                        <i class="bi bi-card-checklist me-1 text-primary"></i> Mô tả chi tiết tiêu chí Rubric:
                    </span>
                    <p class="mb-0 text-dark fw-medium lh-base small">
                        @(string.IsNullOrWhiteSpace(Model.RubricCriteria) ? "Chưa có mô tả rubric cụ thể." : Model.RubricCriteria)
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
