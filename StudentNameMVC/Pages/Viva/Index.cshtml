@page
@model StudentNameMVC.Pages.Viva.IndexModel
@{
    ViewData["Title"] = "Cổng phòng thi Vấn đáp AI";
}

<div class="viva-exam-shell">
    <!-- Hero Banner for Viva Lobby -->
    <div class="hero-banner mb-2">
        <span class="hero-sparkle hero-sparkle-1">✦</span>
        <span class="hero-sparkle hero-sparkle-2">✦</span>
        <span class="hero-sparkle hero-sparkle-3">★</span>

        <div class="mb-3">
            <a href="/Account/Dashboard" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center">
                <i class="bi bi-arrow-left me-1"></i> Về Dashboard
            </a>
        </div>
        <span class="hero-tag">AIVES VIVA CORE 2.0</span>
        <h1 class="hero-title mb-2">Chào mừng bạn đến với Phòng thi Vấn đáp AI</h1>
        <p class="text-white-50 mb-4" style="max-width: 620px; font-size: 15px;">
            Hệ thống phỏng vấn vấn đáp tích hợp Trí tuệ Nhân tạo: AI đặt câu hỏi bằng giọng nói, thí sinh trả lời qua microphone trực tiếp và AI tự động sinh câu hỏi hỏi xoáy theo thời gian thực.
        </p>

        <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="badge bg-white bg-opacity-20 px-3 py-2 rounded-pill text-white fw-semibold">
                <i class="bi bi-mic-fill me-1"></i> Whisper STT Voice
            </span>
            <span class="badge bg-white bg-opacity-20 px-3 py-2 rounded-pill text-white fw-semibold">
                <i class="bi bi-volume-up-fill me-1"></i> OpenAI Speech TTS
            </span>
            <span class="badge bg-white bg-opacity-20 px-3 py-2 rounded-pill text-white fw-semibold">
                <i class="bi bi-robot me-1"></i> Adaptive Follow-up LLM
            </span>
        </div>
    </div>

    @if (User.IsInRole(AIVES.BLL.Security.ApplicationRoles.Lecturer))
    {
        <div class="alert alert-info border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3 p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="brand-icon-box" style="width: 44px; height: 44px; font-size: 20px; border-radius: 12px; background: #e0f2fe; color: #0284c7;">
                    <i class="bi bi-info-circle-fill"></i>
                </div>
                <div>
                    <strong class="text-dark d-block">Tài khoản Giảng viên Khảo thí</strong>
                    <span class="text-secondary small">Phòng thi vấn đáp trực tiếp được thiết kế dành cho Thí sinh (Sinh viên). Với vai trò Giảng viên, bạn có thể giám sát tiến độ thi, xem bảng điểm và đánh giá câu trả lời theo chuẩn rubric.</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/Account/LecturerDashboard" class="btn btn-sm btn-outline-primary rounded-pill fw-bold px-3">
                    <i class="bi bi-grid-fill me-1"></i> Dashboard Giảng viên
                </a>
                <a href="/ClassReports" class="btn btn-sm btn-primary rounded-pill fw-bold px-3">
                    <i class="bi bi-bar-chart-steps me-1"></i> Thống kê Lớp học
                </a>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (!Model.IsAiConfigured)
    {
        <div class="alert alert-warning border-0 rounded-4 shadow-sm d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4" role="alert">
            <div>
                <i class="bi bi-exclamation-octagon-fill me-2 text-warning"></i>
                <strong>Chưa cấu hình AI:</strong> Chưa cấu hình AI, vui lòng nhờ Admin vào Cấu hình AI để thiết lập API key hoặc kết nối máy chủ AI trước khi tạo phiên thi.
            </div>
            @if (User.IsInRole("Admin"))
            {
                <a href="/Admin/AiSettings" class="btn btn-sm btn-warning rounded-pill fw-bold px-3">
                    <i class="bi bi-sliders me-1"></i> Mở Cấu hình AI
                </a>
            }
        </div>
    }

    <div class="row g-4">
        <!-- LEFT COLUMN: Workflow Guide & Device Testing -->
        <div class="col-lg-7">
            <!-- 1. Examination Workflow Guide -->
            <div class="viva-panel-card mb-4">
                <div class="viva-panel-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                        <h5 class="mb-0 fw-bold text-dark">Quy trình thi vấn đáp AI 5 bước</h5>
                    </div>
                    <span class="badge tag-purple">Chuẩn quy trình</span>
                </div>
                <div class="viva-panel-body p-4">
                    <div class="viva-step-item">
                        <div class="viva-step-num">1</div>
                        <div>
                            <div class="fw-bold text-dark mb-1">Kết nối phòng thi & Điểm danh realtime</div>
                            <div class="text-secondary small">Xác thực tài khoản và kết nối tới Hub SignalR để truyền dữ liệu trạng thái phòng thi liên tục.</div>
                        </div>
                    </div>

                    <div class="viva-step-item">
                        <div class="viva-step-num">2</div>
                        <div>
                            <div class="fw-bold text-dark mb-1">Lắng nghe câu hỏi chính qua giọng nói AI (TTS)</div>
                            <div class="text-secondary small">Hệ thống phát âm thanh câu hỏi tự động bằng giọng đọc tiếng Việt tự nhiên và hiển thị nội dung trên màn hình.</div>
                        </div>
                    </div>

                    <div class="viva-step-item">
                        <div class="viva-step-num">3</div>
                        <div>
                            <div class="fw-bold text-dark mb-1">Ghi âm câu trả lời qua Microphone</div>
                            <div class="text-secondary small">Thí sinh bật micro nói trực tiếp trong thời gian quy định, quan sát bộ đo sóng âm WebAudio trực quan.</div>
                        </div>
                    </div>

                    <div class="viva-step-item">
                        <div class="viva-step-num">4</div>
                        <div>
                            <div class="fw-bold text-dark mb-1">Chuyển giọng nói sang văn bản (STT Whisper)</div>
                            <div class="text-secondary small">Bản ghi giọng nói được chuyển thành văn bản tức thời, lưu trữ vào SQL Server và cập nhật trên giao diện.</div>
                        </div>
                    </div>

                    <div class="viva-step-item">
                        <div class="viva-step-num">5</div>
                        <div>
                            <div class="fw-bold text-dark mb-1">Trả lời câu hỏi hỏi xoáy / làm rõ (Follow-up)</div>
                            <div class="text-secondary small">AI phân tích lỗ hổng hoặc điểm mơ hồ trong câu trả lời để sinh câu hỏi đào sâu trước khi kết thúc bài thi.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Interactive Device Testing (Microphone & Speaker) -->
            <div class="viva-panel-card">
                <div class="viva-panel-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <h5 class="mb-0 fw-bold text-dark">Kiểm tra Micro & Thiết bị âm thanh</h5>
                    </div>
                    <span class="badge tag-cyan">Khuyến nghị</span>
                </div>
                <div class="viva-panel-body p-4">
                    <div class="row g-3">
                        <!-- Microphone Test -->
                        <div class="col-md-6">
                            <div class="p-3 rounded-4 border bg-light h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="fw-bold text-dark"><i class="bi bi-mic-fill text-danger me-1"></i> Microphone</div>
                                        <button type="button" id="btnTestMic" class="btn btn-outline-primary btn-sm px-3 rounded-pill">
                                            <i class="bi bi-soundwave me-1"></i> Kiểm tra Micro
                                        </button>
                                    </div>
                                    <small class="text-muted d-block" id="micStatusText">Kiểm tra quyền truy cập microphone.</small>
                                </div>
                                <div id="micFeedbackAlert" class="mt-2 d-none"></div>
                            </div>
                        </div>

                        <!-- Speaker Test -->
                        <div class="col-md-6">
                            <div class="p-3 rounded-4 border bg-light h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="fw-bold text-dark"><i class="bi bi-headphones text-success me-1"></i> Tai nghe / Loa</div>
                                        <button type="button" id="btnTestSpeaker" class="btn btn-outline-success btn-sm px-3 rounded-pill">
                                            <i class="bi bi-volume-up-fill me-1"></i> Thử Loa
                                        </button>
                                    </div>
                                    <small class="text-muted d-block" id="speakerStatusText">Phát âm thanh kiểm tra tai nghe.</small>
                                </div>
                                <div id="speakerFeedbackAlert" class="mt-2 d-none"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Create Session & Enter Room Actions -->
        <div class="col-lg-5">
            <!-- 1. Quick Launch Exam (EXAM01) -->
            <div class="viva-panel-card mb-4" style="border: 2px solid #e0e7ff;">
                <div class="viva-panel-header" style="background: #f5f3ff;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-play-circle-fill text-primary fs-5"></i>
                        <h5 class="mb-0 fw-bold text-dark">Khởi tạo bài thi nhanh</h5>
                    </div>
                    <span class="badge bg-primary text-white rounded-pill px-3 py-1">Phổ biến</span>
                </div>
                <div class="viva-panel-body p-4">
                    <div class="p-3 rounded-4 mb-3" style="background: #f8fafc; border: 1px solid var(--border-subtle);">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="badge tag-purple">MÃ ĐỀ: EXAM01</span>
                            <small class="text-muted"><i class="bi bi-clock me-1"></i> 90 giây / câu</small>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Kiến trúc ASP.NET Core & Dependency Injection</h6>
                        <small class="text-secondary">Khảo thí chuyên sâu về Transient, Scoped, Singleton và kiến trúc 3 lớp.</small>
                    </div>

                    @if (!Model.IsCandidate)
                    {
                        <div class="alert alert-secondary mb-0 rounded-4" role="note">
                            <i class="bi bi-person-lock me-2"></i>Chỉ tài khoản Sinh viên được vào thi. Quản trị viên và Giảng viên không tham gia thi vấn đáp.
                        </div>
                    }
                    else if (Model.IsOrchestratorAvailable)
                    {
                        <form method="post" asp-page-handler="Create">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ExamIdInput" value="EXAM01" />
                            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2" @(!Model.IsAiConfigured ? "disabled" : null)>
                                <i class="bi bi-lightning-charge-fill"></i> Vào thi ngay đề EXAM01
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0 rounded-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Chức năng Viva Orchestrator đang bảo trì.
                        </div>
                    }
                </div>
            </div>

            <!-- 2. Exam selection: Nhóm 2 (kỳ thi & lịch thi) chưa triển khai, mọi sinh viên mặc định vào đề EXAM01 -->
            <div class="alert alert-info rounded-4 mb-4 small" role="note">
                <i class="bi bi-info-circle-fill me-2"></i>Chức năng quản lý kỳ thi chưa triển khai: mọi sinh viên mặc định vào phòng thi đề <strong>EXAM01</strong>.
            </div>

            <!-- 3. Join by Existing SessionId -->
            <div class="viva-panel-card">
                <div class="viva-panel-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-door-open-fill text-primary fs-5"></i>
                        <h5 class="mb-0 fw-bold text-dark">Tham gia phòng thi theo mã phiên</h5>
                    </div>
                </div>
                <div class="viva-panel-body p-4">
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary mb-1">Mã Guid phiên thi (Session ID)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0" style="border-radius: 14px 0 0 14px;">
                                    <i class="bi bi-key-fill text-muted"></i>
                                </span>
                                <input asp-for="SessionIdInput" class="form-control" style="border-radius: 0 14px 14px 0; padding: 12px;" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" required />
                            </div>
                            <div class="form-text small text-muted mt-1">Dành cho thí sinh tiếp tục phiên thi đã được cấp trước.</div>
                        </div>
                        <button type="submit" class="btn btn-dark w-100 py-2 rounded-pill fw-bold" style="background: var(--dark-charcoal);">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Tham gia phiên thi
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('btnTestMic')?.addEventListener('click', async function () {
            const feedback = document.getElementById('micFeedbackAlert');
            const statusText = document.getElementById('micStatusText');
            feedback.className = 'mt-2 alert alert-info py-2 small rounded-3 border-0';
            feedback.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Đang yêu cầu quyền truy cập micro...';
            feedback.classList.remove('d-none');

            try {
                if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                    throw new Error('Trình duyệt không hỗ trợ MediaDevices API.');
                }
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                stream.getTracks().forEach(t => t.stop());
                feedback.className = 'mt-2 alert alert-success py-2 small rounded-3 border-0';
                feedback.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Microphone hoạt động tốt! Sẵn sàng làm bài thi.';
                statusText.textContent = 'Microphone đã được cấp quyền thành công.';
            } catch (err) {
                feedback.className = 'mt-2 alert alert-danger py-2 small rounded-3 border-0';
                feedback.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i> Lỗi micro: ' + (err.message || 'Không thể truy cập microphone.');
                statusText.textContent = 'Chưa cấp quyền microphone.';
            }
        });

        document.getElementById('btnTestSpeaker')?.addEventListener('click', function () {
            const feedback = document.getElementById('speakerFeedbackAlert');
            const statusText = document.getElementById('speakerStatusText');
            feedback.className = 'mt-2 alert alert-info py-2 small rounded-3 border-0';
            feedback.innerHTML = '<i class="bi bi-volume-up me-1"></i> Đang phát âm thanh kiểm tra...';
            feedback.classList.remove('d-none');

            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (AudioCtx) {
                    const ctx = new AudioCtx();
                    const now = ctx.currentTime;
                    const playTone = (freq, start, duration) => {
                        const osc = ctx.createOscillator();
                        const gain = ctx.createGain();
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(freq, start);
                        gain.gain.setValueAtTime(0.2, start);
                        gain.gain.exponentialRampToValueAtTime(0.001, start + duration);
                        osc.connect(gain);
                        gain.connect(ctx.destination);
                        osc.start(start);
                        osc.stop(start + duration);
                    };

                    playTone(523.25, now, 0.22);         // C5
                    playTone(659.25, now + 0.18, 0.22);  // E5
                    playTone(783.99, now + 0.36, 0.35);  // G5
                }
            } catch (e) {
                console.warn('Web Audio warning:', e);
            }

            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance('Kiểm tra âm thanh thành công. Tai nghe của bạn đang hoạt động rất tốt.');
                utter.lang = 'vi-VN';
                window.speechSynthesis.speak(utter);
            }

            feedback.className = 'mt-2 alert alert-success py-2 small rounded-3 border-0';
            feedback.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Đã phát chuông thử nghiệm! Bạn hãy kiểm tra tai nghe có nghe rõ không.';
            statusText.textContent = 'Tai nghe/Loa đã sẵn sàng.';
        });
    </script>
}
