@page
@model StudentNameMVC.Pages.Viva.IndexModel
@{
    ViewData["Title"] = "Cổng phòng thi Vấn đáp AI";
    var isLecturer = User.IsInRole("Lecturer") || User.IsInRole("Admin");
}

<div class="viva-exam-shell">
    <!-- Hero Banner for Viva Lobby -->
    <div class="hero-banner mb-3">
        <span class="hero-sparkle hero-sparkle-1">✦</span>
        <span class="hero-sparkle hero-sparkle-2">✦</span>
        <span class="hero-sparkle hero-sparkle-3">★</span>

        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <a href="/Account/Dashboard" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center">
                <i class="bi bi-arrow-left me-1"></i> Về Dashboard
            </a>
            @if (isLecturer)
            {
                <a href="/Viva/CreateExam" class="btn btn-sm btn-warning rounded-pill px-3.5 py-1.5 fw-bold text-dark d-inline-flex align-items-center shadow-sm">
                    <i class="bi bi-plus-circle-fill me-1.5"></i> Tạo phòng thi mới (Giảng viên)
                </a>
            }
        </div>
        <span class="hero-tag">AIVES VIVA CORE 2.0 · THI TRỰC TUYẾN</span>
        <h1 class="hero-title mb-2">Phòng thi Vấn đáp AI</h1>
        <p class="text-white-50 mb-4" style="max-width: 650px; font-size: 15px;">
            Nhập <strong>Mã phòng thi</strong> do giảng viên cung cấp để bắt đầu phỏng vấn vấn đáp. AI đặt câu hỏi bằng giọng đọc tự nhiên, thí sinh trả lời qua microphone và AI tự động sinh câu hỏi hỏi xoáy theo thời gian thực.
        </p>

        <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="badge bg-white bg-opacity-20 px-3 py-2 rounded-pill text-white fw-semibold">
                <i class="bi bi-mic-fill me-1"></i> Whisper Voice STT
            </span>
            <span class="badge bg-white bg-opacity-20 px-3 py-2 rounded-pill text-white fw-semibold">
                <i class="bi bi-volume-up-fill me-1"></i> OpenAI Speech TTS
            </span>
            <span class="badge bg-white bg-opacity-20 px-3 py-2 rounded-pill text-white fw-semibold">
                <i class="bi bi-robot me-1"></i> Adaptive Follow-up LLM
            </span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <div class="row g-4">
        <!-- LEFT COLUMN: Workflow Guide & Device Testing -->
        <div class="col-lg-7">
            <!-- 1. Examination Workflow Guide -->
            <div class="viva-panel-card mb-4">
                <div class="viva-panel-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                        <h5 class="mb-0 fw-bold text-dark">Quy trình thi vấn đáp AI 5 bước</h5>
                    </div>
                    <span class="badge tag-purple">Chuẩn quy trình</span>
                </div>
                <div class="viva-panel-body p-4">
                    <div class="viva-step-item">
                        <div class="viva-step-num">1</div>
                        <div>
                            <div class="fw-bold text-dark mb-1">Nhập mã phòng thi & Điểm danh realtime</div>
                            <div class="text-secondary small">Nhập mã phòng thi do giảng viên cấp, hệ thống tự động khởi tạo phiên thi và kết nối SignalR Hub.</div>
                        </div>
                    </div>

                    <div class="viva-step-item">
                        <div class="viva-step-num">2</div>
                        <div>
                            <div class="fw-bold text-dark mb-1">Lắng nghe câu hỏi chính qua giọng nói AI (TTS)</div>
                            <div class="text-secondary small">Hệ thống phát âm thanh câu hỏi tự động bằng giọng đọc tiếng Việt tự nhiên và hiển thị nội dung trên màn hình.</div>
                        </div>
                    </div>

                    <div class="viva-step-item">
                        <div class="viva-step-num">3</div>
                        <div>
                            <div class="fw-bold text-dark mb-1">Ghi âm câu trả lời qua Microphone</div>
                            <div class="text-secondary small">Thí sinh bật micro nói trực tiếp trong thời gian quy định, quan sát bộ đo sóng âm WebAudio trực quan.</div>
                        </div>
                    </div>

                    <div class="viva-step-item">
                        <div class="viva-step-num">4</div>
                        <div>
                            <div class="fw-bold text-dark mb-1">Chuyển giọng nói sang văn bản (STT Whisper)</div>
                            <div class="text-secondary small">Bản ghi giọng nói được chuyển thành văn bản tức thời, lưu trữ vào SQL Server và cập nhật trên giao diện.</div>
                        </div>
                    </div>

                    <div class="viva-step-item">
                        <div class="viva-step-num">5</div>
                        <div>
                            <div class="fw-bold text-dark mb-1">Trả lời câu hỏi hỏi xoáy / làm rõ (Follow-up)</div>
                            <div class="text-secondary small">AI phân tích lỗ hổng hoặc điểm mơ hồ trong câu trả lời để sinh câu hỏi đào sâu trước khi kết thúc bài thi.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Interactive Device Testing (Microphone & Speaker) -->
            <div class="viva-panel-card">
                <div class="viva-panel-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <h5 class="mb-0 fw-bold text-dark">Kiểm tra Micro & Thiết bị âm thanh trước khi thi</h5>
                    </div>
                    <span class="badge tag-cyan">Bắt buộc</span>
                </div>
                <div class="viva-panel-body p-4">
                    <div class="row g-3">
                        <!-- Microphone Test -->
                        <div class="col-md-6">
                            <div class="p-3 rounded-4 border bg-light h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="fw-bold text-dark"><i class="bi bi-mic-fill text-danger me-1"></i> Microphone</div>
                                        <button type="button" id="btnTestMic" class="btn btn-outline-primary btn-sm px-3 rounded-pill">
                                            <i class="bi bi-soundwave me-1"></i> Kiểm tra Micro
                                        </button>
                                    </div>
                                    <small class="text-muted d-block" id="micStatusText">Kiểm tra quyền truy cập microphone của bạn.</small>
                                </div>
                                <div id="micFeedbackAlert" class="mt-2 d-none"></div>
                            </div>
                        </div>

                        <!-- Speaker Test -->
                        <div class="col-md-6">
                            <div class="p-3 rounded-4 border bg-light h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="fw-bold text-dark"><i class="bi bi-headphones text-success me-1"></i> Tai nghe / Loa</div>
                                        <button type="button" id="btnTestSpeaker" class="btn btn-outline-success btn-sm px-3 rounded-pill">
                                            <i class="bi bi-volume-up-fill me-1"></i> Thử Loa
                                        </button>
                                    </div>
                                    <small class="text-muted d-block" id="speakerStatusText">Phát âm thanh mẫu kiểm tra tai nghe.</small>
                                </div>
                                <div id="speakerFeedbackAlert" class="mt-2 d-none"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Enter Exam Room by Code -->
        <div class="col-lg-5">
            <!-- 1. PRIMARY ACTION: Join by Room Code -->
            <div class="viva-panel-card mb-4" style="border: 2px solid #6366f1; box-shadow: 0 10px 25px -5px rgba(99, 102, 241, 0.15);">
                <div class="viva-panel-header" style="background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-door-open-fill text-primary fs-4"></i>
                        <div>
                            <h5 class="mb-0 fw-bold text-dark">Vào phòng thi bằng Mã</h5>
                            <small class="text-muted">Nhập mã phòng do Giảng viên cung cấp</small>
                        </div>
                    </div>
                </div>
                <div class="viva-panel-body p-4">
                    @if (Model.IsOrchestratorAvailable)
                    {
                        <form method="post" asp-page-handler="JoinByCode">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-secondary mb-1">Mã phòng thi / Mã đề thi (Room Code)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0" style="border-radius: 14px 0 0 14px; font-size: 18px;">
                                        <i class="bi bi-key-fill text-primary"></i>
                                    </span>
                                    <input asp-for="ExamIdInput" id="examCodeInput" class="form-control font-monospace fw-bold text-uppercase" style="border-radius: 0 14px 14px 0; padding: 14px; font-size: 16px; letter-spacing: 1px;" placeholder="Ví dụ: PRN222-01, VIVA-1234..." required autofocus />
                                </div>
                                <div class="form-text small text-muted mt-1.5">
                                    <i class="bi bi-shield-check text-success me-1"></i> Mã hợp lệ sẽ tự động kết nối Giám khảo AI và tải đề thi từ CSDL.
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow d-flex align-items-center justify-content-center gap-2" style="font-size: 16px;">
                                <i class="bi bi-box-arrow-in-right fs-5"></i> Vào phòng thi ngay
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0 rounded-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> Chức năng Viva Orchestrator đang bảo trì.
                        </div>
                    }
                </div>
            </div>

            <!-- 2. Available Rooms List (Quick Pick) -->
            @if (Model.AvailableRooms.Count > 0)
            {
                <div class="viva-panel-card mb-4">
                    <div class="viva-panel-header">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-lightning-charge-fill text-warning fs-5"></i>
                            <h5 class="mb-0 fw-bold text-dark">Các phòng thi đang mở</h5>
                        </div>
                        <span class="badge tag-cyan">@Model.AvailableRooms.Count phòng thi</span>
                    </div>
                    <div class="viva-panel-body p-3">
                        <div class="d-flex flex-column gap-2.5" style="max-height: 280px; overflow-y: auto;">
                            @foreach (var room in Model.AvailableRooms)
                            {
                                <div class="p-2.5 rounded-3 border bg-light d-flex align-items-center justify-content-between gap-2">
                                    <div class="overflow-hidden">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-dark font-monospace text-warning px-2 py-0.5 rounded-pill" style="font-size: 12px;">@room.ExamId</span>
                                            <span class="fw-bold text-dark text-truncate small" style="max-width: 200px;">@room.Title</span>
                                        </div>
                                        <small class="text-muted d-block mt-0.5" style="font-size: 11px;">@room.QuestionCount câu hỏi · @room.DefaultTimeLimitSeconds s/câu</small>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 flex-shrink-0 fw-semibold" onclick="document.getElementById('examCodeInput').value = '@room.ExamId'; document.getElementById('examCodeInput').focus();">
                                        Chọn mã <i class="bi bi-arrow-up-right"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- 3. Join by Existing SessionId GUID (Resume) -->
            <div class="viva-panel-card">
                <div class="viva-panel-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history text-secondary fs-5"></i>
                        <h5 class="mb-0 fw-bold text-dark">Tham gia phòng thi theo mã phiên</h5>
                    </div>
                </div>
                <div class="viva-panel-body p-4">
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary mb-1">Mã Guid phiên thi (Session ID)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0" style="border-radius: 12px 0 0 12px;">
                                    <i class="bi bi-fingerprint text-muted"></i>
                                </span>
                                <input asp-for="SessionIdInput" class="form-control" style="border-radius: 0 12px 12px 0; padding: 10px;" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
                            </div>
                            <div class="form-text small text-muted mt-1">Dành cho thí sinh bị mất kết nối và muốn nối lại phiên thi cũ.</div>
                        </div>
                        <button type="submit" class="btn btn-dark w-100 py-2 rounded-pill fw-bold" style="background: var(--dark-charcoal);">
                            <i class="bi bi-arrow-repeat me-1"></i> Nối lại phiên thi
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('btnTestMic')?.addEventListener('click', async function () {
            const feedback = document.getElementById('micFeedbackAlert');
            const statusText = document.getElementById('micStatusText');
            feedback.className = 'mt-2 alert alert-info py-2 small rounded-3 border-0';
            feedback.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Đang yêu cầu quyền truy cập micro...';
            feedback.classList.remove('d-none');

            try {
                if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                    throw new Error('Trình duyệt không hỗ trợ MediaDevices API.');
                }
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                stream.getTracks().forEach(t => t.stop());
                feedback.className = 'mt-2 alert alert-success py-2 small rounded-3 border-0';
                feedback.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Microphone hoạt động tốt! Sẵn sàng làm bài thi.';
                statusText.textContent = 'Microphone đã được cấp quyền thành công.';
            } catch (err) {
                feedback.className = 'mt-2 alert alert-danger py-2 small rounded-3 border-0';
                feedback.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i> Lỗi micro: ' + (err.message || 'Không thể truy cập microphone.');
                statusText.textContent = 'Chưa cấp quyền microphone.';
            }
        });

        document.getElementById('btnTestSpeaker')?.addEventListener('click', function () {
            const feedback = document.getElementById('speakerFeedbackAlert');
            const statusText = document.getElementById('speakerStatusText');
            feedback.className = 'mt-2 alert alert-info py-2 small rounded-3 border-0';
            feedback.innerHTML = '<i class="bi bi-volume-up me-1"></i> Đang phát âm thanh kiểm tra...';
            feedback.classList.remove('d-none');

            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (AudioCtx) {
                    const ctx = new AudioCtx();
                    const now = ctx.currentTime;
                    const playTone = (freq, start, duration) => {
                        const osc = ctx.createOscillator();
                        const gain = ctx.createGain();
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(freq, start);
                        gain.gain.setValueAtTime(0.2, start);
                        gain.gain.exponentialRampToValueAtTime(0.001, start + duration);
                        osc.connect(gain);
                        gain.connect(ctx.destination);
                        osc.start(start);
                        osc.stop(start + duration);
                    };

                    playTone(523.25, now, 0.22);         // C5
                    playTone(659.25, now + 0.18, 0.22);  // E5
                    playTone(783.99, now + 0.36, 0.35);  // G5
                }
            } catch (e) {
                console.warn('Web Audio warning:', e);
            }

            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utter = new SpeechSynthesisUtterance('Kiểm tra âm thanh thành công. Tai nghe của bạn đang hoạt động rất tốt.');
                utter.lang = 'vi-VN';
                utter.rate = 0.95;
                const voices = window.speechSynthesis.getVoices();
                const bestVoice = voices.find(v => v.lang && (v.lang.startsWith('vi') || v.lang.includes('VIE')) && 
                    (v.name.includes('HoaiMy') || v.name.includes('Hoài My') || v.name.includes('NamMinh') || v.name.includes('Nam Minh') || v.name.includes('Natural')))
                    || voices.find(v => v.lang && (v.lang.startsWith('vi') || v.lang.includes('VIE')));
                if (bestVoice) utter.voice = bestVoice;
                window.speechSynthesis.speak(utter);
            }

            feedback.className = 'mt-2 alert alert-success py-2 small rounded-3 border-0';
            feedback.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Đã phát chuông thử nghiệm! Bạn hãy kiểm tra tai nghe có nghe rõ không.';
            statusText.textContent = 'Tai nghe/Loa đã sẵn sàng.';
        });
    </script>
}
