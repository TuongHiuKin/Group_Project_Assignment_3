@page "{sessionId:guid?}"
@model StudentNameMVC.Pages.Viva.ExamModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = $"Phòng thi Vấn đáp - {Model.SessionId}";
    var tokens = Antiforgery.GetAndStoreTokens(HttpContext);
}

<div class="viva-exam-shell">
    <!-- 1. TOP CANDIDATE & REALTIME SESSION STATUS BAR -->
    <div class="viva-header-card">
        <div class="row align-items-center gy-3">
            <!-- Candidate Info -->
            <div class="col-12 col-md-4">
                <div class="viva-candidate-box">
                    <div class="viva-candidate-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <h5 class="mb-1 fw-bold text-dark">@Model.CandidateName</h5>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge tag-purple">MSSV: @(string.IsNullOrEmpty(Model.StudentId) ? "N/A" : Model.StudentId)</span>
                            <span class="badge tag-cyan">Đề: @(string.IsNullOrEmpty(Model.ExamId) ? "EXAM01" : Model.ExamId)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status & Turn Ordinal Badges -->
            <div class="col-6 col-md-4 text-center">
                <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">
                    <span id="sessionStateBadge" class="badge px-3 py-2 rounded-pill bg-info text-dark fw-bold">
                        Đang kết nối...
                    </span>
                    <span id="turnProgressBadge" class="badge px-3 py-2 rounded-pill bg-light text-secondary border fw-bold">
                        Lượt thi: @Model.CurrentTurn / @Model.MaxTurns
                    </span>
                </div>
            </div>

            <!-- Countdown Timer & Progress Bar -->
            <div class="col-6 col-md-4 text-end">
                <div class="d-inline-flex flex-column align-items-end">
                    <div class="viva-timer-chip">
                        <i class="bi bi-stopwatch-fill"></i>
                        <span id="countdownTimerDisplay">00:00</span>
                    </div>
                    <div class="viva-progress-track">
                        <div id="timerProgressBar" class="viva-progress-fill" style="width: 100%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- General Alert Box -->
    <div id="generalAlert" class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm d-none" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>
        <span id="generalAlertText"></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>

    <!-- 2. MAIN EXAMINATION WORKSPACE (2 Columns) -->
    <div class="row g-4">
        <!-- LEFT COLUMN: Questions, AI Follow-up & Realtime Transcript -->
        <div class="col-lg-7">
            <!-- Initial Start Exam Callout (shown before question is delivered) -->
            @{
                var isAlreadyStarted = Model.SessionState != VivaSessionState.Created && Model.SessionState != VivaSessionState.Ready;
            }
            <div id="startExamBanner" class="viva-start-banner mb-4 @(isAlreadyStarted ? "d-none" : "")">
                <div class="brand-icon-box mx-auto mb-3" style="width: 58px; height: 58px; font-size: 26px; border-radius: 18px;">
                    <i class="bi bi-mic-fill"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Phòng thi vấn đáp đã sẵn sàng</h3>
                <p class="text-secondary mx-auto mb-4" style="max-width: 480px; font-size: 14px;">
                    Nhấn nút bên dưới để nhận câu hỏi và bắt đầu bài thi. Giọng đọc AI sẽ tự động đọc câu hỏi bằng tiếng Việt qua công nghệ Text-to-Speech (TTS).
                </p>
                <div>
                    <button type="button" id="btnStartExam" class="viva-btn-start">
                        <i class="bi bi-play-circle-fill"></i>
                        <span>Bắt đầu làm bài thi</span>
                    </button>
                </div>
            </div>

            <!-- Primary Question Card -->
            <div id="questionCard" class="viva-panel-card mb-4 @(isAlreadyStarted ? "" : "d-none")">
                <div class="viva-panel-header">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge tag-purple">CÂU HỎI CHÍNH</span>
                        <h6 id="questionTitle" class="mb-0 fw-bold text-dark">@(string.IsNullOrEmpty(Model.InitialQuestionTitle) ? "Đang tải câu hỏi..." : Model.InitialQuestionTitle)</h6>
                    </div>
                    <div>
                        <button type="button" id="btnPlayQuestionAudio" class="btn btn-outline-primary btn-sm rounded-pill d-none">
                            <i class="bi bi-volume-up-fill me-1"></i> Nghe lại câu hỏi
                        </button>
                        <audio id="questionAudio" class="d-none" preload="auto"></audio>
                    </div>
                </div>
                <div class="viva-panel-body p-4">
                    <p id="questionContent" class="fs-5 text-dark lh-base mb-0 fw-semibold">
                        @(string.IsNullOrEmpty(Model.InitialQuestionContent) ? "Vui lòng nhấn Bắt đầu làm bài để nhận câu hỏi." : Model.InitialQuestionContent)
                    </p>
                </div>
            </div>

            <!-- Follow-up Question Card (AI Adaptive Probing) -->
            <div id="followUpCard" class="viva-panel-card mb-4 d-none" style="border: 2px solid #818cf8; background: #fafaff;">
                <div class="viva-panel-header" style="background: #f4efff;">
                    <div class="d-flex align-items-center gap-2">
                        <span id="followUpBadge" class="badge tag-pink fw-bold">
                            <i class="bi bi-robot me-1"></i> Câu hỏi phụ AI
                        </span>
                        <h6 class="mb-0 fw-bold text-primary">Phản biện đào sâu từ Giám khảo AI</h6>
                    </div>
                    <div>
                        <button type="button" id="btnPlayFollowUpAudio" class="btn btn-outline-primary btn-sm rounded-pill d-none">
                            <i class="bi bi-volume-up-fill me-1"></i> Nghe câu hỏi phụ
                        </button>
                        <audio id="followUpAudio" class="d-none" preload="auto"></audio>
                    </div>
                </div>
                <div class="viva-panel-body p-4">
                    <p id="followUpContent" class="fs-5 text-dark fw-bold lh-base mb-0 text-primary"></p>
                </div>
            </div>

            <!-- Realtime Transcript Box (Whisper Speech-to-Text) -->
            <div id="transcriptCard" class="viva-panel-card mb-4 d-none">
                <div class="viva-panel-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-chat-quote-fill text-success fs-5"></i>
                        <h6 class="mb-0 fw-bold text-dark">Bản ghi âm câu trả lời (Speech-to-Text)</h6>
                    </div>
                    <span id="transcriptConfidence" class="badge bg-secondary rounded-pill">Đang nhận diện...</span>
                </div>
                <div class="viva-panel-body p-4">
                    <div id="transcriptionSpinner" class="d-flex align-items-center text-primary mb-3 d-none">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                        <span class="small fw-bold">AI đang phân tích âm thanh và chuyển đổi giọng nói...</span>
                    </div>
                    <div class="viva-transcript-quote">
                        <p id="transcriptText" class="mb-0"></p>
                    </div>
                </div>
            </div>

            <!-- Follow-up generation failure (LLM 429/503/timeout): retry or finish -->
            <div id="followUpErrorCard" class="viva-panel-card mb-4 p-4 d-none" style="border: 2px solid #fecaca; background: #fef2f2;" role="alert">
                <div class="d-flex align-items-start gap-2 mb-3">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                    <span id="followUpErrorText" class="text-dark fw-semibold">Giám khảo AI chưa tạo được câu hỏi phụ.</span>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" id="btnRetryFollowUp" class="btn btn-danger rounded-pill px-4 fw-bold">
                        <i class="bi bi-arrow-clockwise me-1"></i> Thử lại
                    </button>
                    <button type="button" id="btnFinishSession" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                        <i class="bi bi-flag me-1"></i> Kết thúc bài thi
                    </button>
                </div>
            </div>

            <!-- Session Completed Summary Card -->
            <div id="completedCard" class="viva-panel-card p-5 text-center d-none" style="border: 2px solid #a7f3d0; background: #f0fdf4;">
                <div class="mb-3">
                    <span class="badge bg-success p-3 rounded-circle" style="width: 64px; height: 64px; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="bi bi-check-lg fs-1 text-white"></i>
                    </span>
                </div>
                <h3 class="fw-bold text-dark mb-2">Hoàn thành buổi thi vấn đáp!</h3>
                <p class="text-secondary mb-4 mx-auto" style="max-width: 480px;">
                    Toàn bộ câu trả lời, bản ghi âm giọng nói và transcript đã được lưu trữ an toàn vào hệ thống.
                </p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a asp-page="/StudentReports/Index" class="btn btn-primary px-4">
                        <i class="bi bi-file-earmark-bar-graph me-1"></i> Xem báo cáo kết quả
                    </a>
                    <a asp-page="/Account/Dashboard" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-house me-1"></i> Quay về Dashboard
                    </a>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Soundwave Visualizer & Microphone Control -->
        <div class="col-lg-5">
            <div id="answeringSection" class="viva-panel-card @(isAlreadyStarted ? "" : "d-none")">
                <div class="viva-panel-header">
                    <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-mic text-danger"></i> Ghi âm câu trả lời
                    </h6>
                    <span id="recordingStatusIndicator" class="badge bg-secondary py-2 px-3 rounded-pill">
                        <i class="bi bi-mic-mute me-1"></i> Sẵn sàng
                    </span>
                </div>

                <div class="viva-panel-body p-4">
                    <!-- Soundwave Visualizer Canvas -->
                    <div class="viva-soundwave-card mb-4 text-center">
                        <canvas id="visualizerCanvas" width="400" height="130" class="w-100 rounded-3" style="background-color: #0b1120;"></canvas>
                        <div class="d-flex justify-content-between text-muted small px-2 mt-2">
                            <span class="fs-8 text-light"><i class="bi bi-soundwave text-info me-1"></i>WebAudio Oscilloscope</span>
                            <span id="recordingStatusText" class="text-info fs-8 fw-semibold">Nhấn nút bên dưới để bắt đầu nói</span>
                        </div>
                    </div>

                    <!-- Recording Action Buttons -->
                    <div class="viva-record-btn-group">
                        <button type="button" id="btnStartRecord" class="viva-btn-record viva-btn-record-danger">
                            <i class="bi bi-mic-fill fs-5"></i>
                            <span>Bắt đầu ghi âm câu trả lời</span>
                        </button>

                        <button type="button" id="btnStopRecord" class="viva-btn-record viva-btn-record-success d-none">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <span>Hoàn tất & Nộp câu trả lời</span>
                        </button>

                        <button type="button" id="btnRetryRecord" class="viva-btn-record viva-btn-record-warning d-none">
                            <i class="bi bi-arrow-clockwise fs-5"></i>
                            <span>Ghi âm lại câu trả lời</span>
                        </button>
                    </div>

                    <div class="mt-4 p-3 rounded-4 bg-light text-center border" style="border-style: dashed !important;">
                        <small class="text-muted">
                            <i class="bi bi-info-circle text-primary me-1"></i>
                            Sau khi nộp câu trả lời, AI sẽ tự động phân tích và đưa ra câu hỏi hỏi xoáy phản biện.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Floating Toast Container for Realtime Notifications -->
<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <div id="vivaErrorToast" class="toast align-items-center text-white bg-danger border-0 rounded-4 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-octagon-fill fs-4"></i>
                <div>
                    <strong id="vivaErrorToastCode" class="d-block">LỖI THI</strong>
                    <span id="vivaErrorToastMessage" class="small">Đã xảy ra sự cố không xác định.</span>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white me-3 m-auto" data-bs-dismiss="toast" aria-label="Đóng"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/viva-audio-recorder.js" asp-append-version="true"></script>
    <script src="~/js/viva-signalr-client.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const client = new VivaExamClient({
                sessionId: '@Model.SessionId',
                examId: '@Model.ExamId',
                studentId: '@Model.StudentId',
                initialQuestionId: '@Model.InitialQuestionId',
                antiForgeryToken: '@tokens.RequestToken',
                submitAudioUrl: '@Url.Page("/Viva/Exam", "SubmitAudio")',
                startSessionUrl: '@Url.Page("/Viva/Exam", "StartSession")',
                retryFollowUpUrl: '@Url.Page("/Viva/Exam", "RetryFollowUp")',
                finishSessionUrl: '@Url.Page("/Viva/Exam", "FinishSession")',
                initialState: '@Model.SessionState'
            });
            window.vivaExamClient = client;
        });
    </script>
}
