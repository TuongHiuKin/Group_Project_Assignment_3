@page "{sessionId:guid?}"
@model StudentNameMVC.Pages.Viva.ExamModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = $"Phòng thi Vấn đáp - {Model.SessionId}";
    var tokens = Antiforgery.GetAndStoreTokens(HttpContext);
}

<div class="container-fluid px-2 px-md-4">
    <!-- Top Status Bar & Candidate Overview -->
    <div class="card viva-card bg-white border-0 shadow-sm mb-3">
        <div class="card-body p-3">
            <div class="row align-items-center gy-2">
                <div class="col-12 col-md-4">
                    <div class="d-flex align-items-center">
                        <div class="avatar-box bg-primary text-white rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px;">
                            <i class="bi bi-person-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">@Model.CandidateName</h6>
                            <small class="text-muted">
                                MSSV: <strong class="text-primary">@(string.IsNullOrEmpty(Model.StudentId) ? "Chưa xác định" : Model.StudentId)</strong> &bull;
                                Môn: <strong class="text-dark">@(string.IsNullOrEmpty(Model.ExamId) ? "Chưa xác định" : Model.ExamId)</strong>
                            </small>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-4 text-center">
                    <div class="d-flex justify-content-center align-items-center gap-2">
                        <span id="sessionStateBadge" class="badge px-3 py-2 rounded-pill bg-info text-dark fw-semibold">
                            Đang kết nối...
                        </span>
                        <span id="turnProgressBadge" class="badge px-3 py-2 rounded-pill bg-secondary fw-semibold">
                            Lượt thi: @Model.CurrentTurn / @Model.MaxTurns
                        </span>
                    </div>
                </div>

                <div class="col-6 col-md-4 text-end">
                    <div class="d-inline-flex flex-column align-items-end">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-stopwatch-fill text-danger fs-4"></i>
                            <div id="countdownTimerDisplay" class="viva-timer-box text-primary">00:00</div>
                        </div>
                        <div class="progress mt-1" style="width: 140px; height: 6px;">
                            <div id="timerProgressBar" class="progress-bar bg-primary" role="progressbar" style="width: 100%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- General Alert Box -->
    <div id="generalAlert" class="alert alert-danger alert-dismissible fade show d-none" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <span id="generalAlertText"></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>

    <!-- Main Exam Area -->
    <div class="row g-3">
        <!-- Left Column: Questions & Follow-ups -->
        <div class="col-lg-7">
            <!-- Initial Start Exam Callout (when session is ready) -->
            <div id="startExamBanner" class="card viva-card bg-light border-primary border-opacity-25 p-4 mb-3 text-center">
                <i class="bi bi-mic-fill text-primary display-4 mb-2"></i>
                <h4 class="fw-bold text-dark mb-2">Phòng thi đã sẵn sàng</h4>
                <p class="text-muted mb-3">
                    Nhấn nút bên dưới để nhận câu hỏi và bắt đầu bài thi vấn đáp.
                    Câu hỏi sẽ được phát âm thanh tự động qua công nghệ TTS.
                </p>
                <div>
                    <button type="button" id="btnStartExam" class="btn btn-primary btn-lg px-4 py-2 rounded-pill fw-semibold shadow-sm">
                        <i class="bi bi-play-circle-fill me-2"></i> Bắt đầu làm bài
                    </button>
                </div>
            </div>

            <!-- Primary Question Card -->
            <div id="questionCard" class="card viva-card bg-white border-0 shadow-sm mb-3 d-none">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary px-3 py-2 rounded-pill">Câu hỏi chính</span>
                        <h5 id="questionTitle" class="mb-0 fw-bold text-dark">@(string.IsNullOrEmpty(Model.InitialQuestionTitle) ? "Đang tải câu hỏi..." : Model.InitialQuestionTitle)</h5>
                    </div>
                    <div>
                        <button type="button" id="btnPlayQuestionAudio" class="btn btn-outline-primary btn-sm rounded-pill d-none">
                            <i class="bi bi-volume-up-fill me-1"></i> Nghe lại câu hỏi
                        </button>
                        <audio id="questionAudio" class="d-none" preload="auto"></audio>
                    </div>
                </div>
                <div class="card-body p-4">
                    <p id="questionContent" class="fs-5 text-dark lh-base mb-0">
                        @(string.IsNullOrEmpty(Model.InitialQuestionContent) ? "Vui lòng nhấn Bắt đầu làm bài để nhận câu hỏi vấn đáp." : Model.InitialQuestionContent)
                    </p>
                </div>
            </div>

            <!-- Follow-up Question Card (UI-05) -->
            <div id="followUpCard" class="card viva-card border-0 shadow-sm mb-3 d-none" style="background-color: #f0f7ff; border-left: 5px solid #2563eb !important;">
                <div class="card-header border-0 bg-transparent py-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span id="followUpBadge" class="badge bg-info text-dark px-3 py-2 rounded-pill fw-bold">
                            <i class="bi bi-robot me-1"></i>Câu hỏi phụ AI
                        </span>
                        <h6 class="mb-0 fw-bold text-primary">Phản hồi mở rộng từ AI</h6>
                    </div>
                    <div>
                        <button type="button" id="btnPlayFollowUpAudio" class="btn btn-outline-primary btn-sm rounded-pill d-none">
                            <i class="bi bi-volume-up-fill me-1"></i> Nghe câu hỏi phụ
                        </button>
                        <audio id="followUpAudio" class="d-none" preload="auto"></audio>
                    </div>
                </div>
                <div class="card-body p-4 pt-1">
                    <p id="followUpContent" class="fs-5 text-dark fw-medium lh-base mb-0"></p>
                </div>
            </div>

            <!-- Realtime Transcript Box (UI-04) -->
            <div id="transcriptCard" class="card viva-card bg-white border-0 shadow-sm mb-3 d-none">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-chat-quote-fill text-success fs-5"></i>
                        <h6 class="mb-0 fw-bold text-dark">Bản ghi âm câu trả lời (Speech-to-Text)</h6>
                    </div>
                    <span id="transcriptConfidence" class="badge bg-secondary rounded-pill">Đang nhận diện...</span>
                </div>
                <div class="card-body p-4">
                    <div id="transcriptionSpinner" class="d-flex align-items-center text-primary mb-3 d-none">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                        <span class="small fw-semibold">AI đang xử lý âm thanh và nhận diện giọng nói...</span>
                    </div>
                    <blockquote class="blockquote mb-0">
                        <p id="transcriptText" class="fs-6 text-dark fst-italic mb-0 text-secondary"></p>
                    </blockquote>
                </div>
            </div>

            <!-- Session Completed Summary Card -->
            <div id="completedCard" class="card viva-card bg-white border-0 shadow-sm p-4 text-center d-none">
                <div class="mb-3">
                    <span class="badge bg-success p-3 rounded-circle">
                        <i class="bi bi-check-lg display-4 text-white"></i>
                    </span>
                </div>
                <h3 class="fw-bold text-dark mb-2">Hoàn thành buổi thi vấn đáp!</h3>
                <p class="text-muted mb-4">
                    Toàn bộ câu trả lời và dữ liệu giọng nói của bạn đã được lưu trữ an toàn trong hệ thống.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="StudentReports" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-file-earmark-bar-graph me-1"></i> Xem báo cáo kết quả
                    </a>
                    <a asp-controller="Account" asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-house me-1"></i> Quay về trang chủ
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Column: Audio Recording & Visualizer Controls (UI-03, UI-06) -->
        <div class="col-lg-5">
            <div id="answeringSection" class="card viva-card bg-white border-0 shadow-sm p-3">
                <div class="card-header bg-white border-0 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-mic text-danger me-2"></i>Khu vực ghi âm câu trả lời
                    </h5>
                    <span id="recordingStatusIndicator" class="badge bg-secondary py-2 px-3 rounded-pill">
                        <i class="bi bi-mic-mute me-1"></i> Sẵn sàng
                    </span>
                </div>

                <div class="card-body p-3">
                    <!-- Soundwave Visualizer Canvas -->
                    <div class="bg-dark rounded-3 overflow-hidden p-2 mb-3 shadow-inner text-center">
                        <canvas id="visualizerCanvas" width="400" height="120" class="w-100 rounded-2" style="background-color: #0f172a;"></canvas>
                        <div class="d-flex justify-content-between text-muted small px-2 mt-1">
                            <span class="fs-8"><i class="bi bi-soundwave me-1"></i>Bộ đo sóng âm WebAudio</span>
                            <span id="recordingStatusText" class="text-info fs-8">Nhấn nút bên dưới để bắt đầu nói</span>
                        </div>
                    </div>

                    <!-- Recording Action Buttons -->
                    <div class="d-grid gap-2">
                        <button type="button" id="btnStartRecord" class="btn btn-danger btn-lg py-3 rounded-3 fw-bold shadow-sm">
                            <i class="bi bi-mic-fill me-2"></i> Bắt đầu ghi âm câu trả lời
                        </button>

                        <button type="button" id="btnStopRecord" class="btn btn-success btn-lg py-3 rounded-3 fw-bold shadow-sm d-none">
                            <i class="bi bi-check-circle-fill me-2"></i> Hoàn thành & Nộp câu trả lời
                        </button>

                        <button type="button" id="btnRetryRecord" class="btn btn-outline-warning py-2 rounded-3 fw-semibold d-none">
                            <i class="bi bi-arrow-clockwise me-1"></i> Ghi âm lại câu trả lời
                        </button>
                    </div>

                    <div class="mt-3 text-center">
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Sau khi hoàn tất, hệ thống sẽ tự động chuyển giọng nói thành văn bản và kích hoạt AI sinh câu hỏi phụ.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Floating Toast Container for Realtime Notifications -->
<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <!-- Viva Error Toast Template -->
    <div id="vivaErrorToast" class="toast align-items-center text-white bg-danger border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
                <strong id="vivaErrorToastCode" class="me-1">LỖI</strong>
                <span id="vivaErrorToastMessage">Đã xảy ra sự cố không xác định.</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Đóng"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/viva-audio-recorder.js" asp-append-version="true"></script>
    <script src="~/js/viva-signalr-client.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const client = new VivaExamClient({
                sessionId: '@Model.SessionId',
                examId: '@Model.ExamId',
                studentId: '@Model.StudentId',
                initialQuestionId: '@Model.InitialQuestionId',
                antiForgeryToken: '@tokens.RequestToken',
                submitAudioUrl: '@Url.Page("/Viva/Exam", "SubmitAudio")',
                startSessionUrl: '@Url.Page("/Viva/Exam", "StartSession")',
                initialState: '@Model.SessionState'
            });
        });
    </script>
}
