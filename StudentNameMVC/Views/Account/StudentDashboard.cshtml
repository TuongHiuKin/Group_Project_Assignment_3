@using AIVES.BLL.Security
@{
    ViewData["Title"] = "Student Dashboard";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? ApplicationRoles.Staff;
    var userName = User.Identity?.Name ?? "Sinh viên";
}

<!-- Top Role Header Bar -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold mb-0 text-dark">Dashboard Sinh viên / Thí sinh</h4>
            <span class="badge rounded-pill px-3 py-1 small" style="background: #3b82f6; color: #ffffff;">
                <i class="bi bi-mortarboard-fill me-1"></i> Student Portal
            </span>
        </div>
        <p class="text-muted small mb-0">Cổng luyện thi vấn đáp AI Viva, chuẩn bị phòng thi âm thanh và theo dõi tiến độ cá nhân</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-page="/Viva/Index" class="btn btn-primary rounded-pill px-3 py-1.5 fw-bold shadow-sm">
            <i class="bi bi-camera-video-fill me-1"></i> Phòng thi Viva
        </a>
        <a asp-controller="StudentReports" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-1.5 fw-bold">
            <i class="bi bi-journal-check me-1"></i> Báo cáo Cá nhân
        </a>
    </div>
</div>

<!-- ========================================================
     DASHBOARD: SINH VIÊN / THÍ SINH (STUDENT DASHBOARD)
     ======================================================== -->
<div class="dashboard-grid">
    <!-- Main Column -->
    <div class="dashboard-main-col">
        <!-- 1. Hero Banner: Student Learning & Viva Exam -->
        <div class="hero-banner">
            <span class="hero-sparkle hero-sparkle-1">✦</span>
            <span class="hero-sparkle hero-sparkle-2">✦</span>
            <span class="hero-sparkle hero-sparkle-3">★</span>

            <span class="hero-tag">ONLINE VIVA EXAM</span>
            <h1 class="hero-title">Rèn luyện tư duy vấn đáp thông minh cùng Giám khảo AI</h1>
            <a asp-page="/Viva/Index" class="hero-btn">
                <span>Vào phòng thi ngay</span>
                <span class="hero-btn-arrow"><i class="bi bi-chevron-right"></i></span>
            </a>
        </div>

        <!-- 2. Student Quick Stat Mini Cards -->
        <div class="stat-mini-row">
            <div class="stat-mini-card">
                <div class="stat-mini-icon-box icon-purple">
                    <i class="bi bi-code-slash"></i>
                </div>
                <div class="stat-mini-info">
                    <span class="stat-mini-metric">2/8 hoàn thành</span>
                    <span class="stat-mini-title">ASP.NET Core DI</span>
                </div>
            </div>

            <div class="stat-mini-card">
                <div class="stat-mini-icon-box icon-pink">
                    <i class="bi bi-chat-quote-fill"></i>
                </div>
                <div class="stat-mini-info">
                    <span class="stat-mini-metric">3 lượt hỏi xoáy</span>
                    <span class="stat-mini-title">AI Adaptive LLM</span>
                </div>
            </div>

            <div class="stat-mini-card">
                <div class="stat-mini-icon-box icon-cyan">
                    <i class="bi bi-mic-fill"></i>
                </div>
                <div class="stat-mini-info">
                    <span class="stat-mini-metric">98% tin cậy</span>
                    <span class="stat-mini-title">Whisper Voice STT</span>
                </div>
            </div>
        </div>

        <!-- 3. Đề thi vấn đáp sẵn sàng (Continue Watching style) -->
        <div class="section-header">
            <h2 class="section-title">Chủ đề thi vấn đáp & Phòng thi sẵn sàng</h2>
            <div class="section-controls">
                <button type="button" class="carousel-arrow-btn" aria-label="Previous"><i class="bi bi-chevron-left"></i></button>
                <button type="button" class="carousel-arrow-btn" aria-label="Next"><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>

        <div class="course-cards-grid">
            <!-- Card 1 -->
            <div class="course-card">
                <div class="course-card-thumb-wrap">
                    <img src="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=600&q=80" alt="ASP.NET Core" class="course-card-thumb-img" />
                    <button type="button" class="course-card-heart" title="Lưu chủ đề"><i class="bi bi-heart"></i></button>
                </div>
                <div class="course-card-body">
                    <span class="course-tag-pill tag-cyan">KIẾN TRÚC .NET</span>
                    <h3 class="course-card-title">Thiết kế kiến trúc 3 lớp & Dependency Injection trong .NET 8</h3>
                    <div class="course-card-footer">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=80&q=80" alt="Mentor" class="course-mentor-avatar" />
                        <div class="course-mentor-info">
                            <span class="course-mentor-name">TS. Hoàng Yến</span>
                            <span class="course-mentor-role">Giám khảo AI</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="course-card">
                <div class="course-card-thumb-wrap">
                    <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=600&q=80" alt="SignalR Realtime" class="course-card-thumb-img" />
                    <button type="button" class="course-card-heart" title="Lưu chủ đề"><i class="bi bi-heart"></i></button>
                </div>
                <div class="course-card-body">
                    <span class="course-tag-pill tag-purple">REALTIME SIGNALR</span>
                    <h3 class="course-card-title">Xử lý phòng thi tương tác trực tiếp & Truyền tải sự kiện giọng nói</h3>
                    <div class="course-card-footer">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=80&q=80" alt="Mentor" class="course-mentor-avatar" />
                        <div class="course-mentor-info">
                            <span class="course-mentor-name">ThS. Minh Trí</span>
                            <span class="course-mentor-role">Giám khảo LLM</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="course-card">
                <div class="course-card-thumb-wrap">
                    <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=600&q=80" alt="System Design" class="course-card-thumb-img" />
                    <button type="button" class="course-card-heart" title="Lưu chủ đề"><i class="bi bi-heart"></i></button>
                </div>
                <div class="course-card-body">
                    <span class="course-tag-pill tag-pink">THANG ĐO BLOOM</span>
                    <h3 class="course-card-title">Hỏi xoáy & Đánh giá năng lực giải quyết vấn đề theo Rubric</h3>
                    <div class="course-card-footer">
                        <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=80&q=80" alt="Mentor" class="course-mentor-avatar" />
                        <div class="course-mentor-info">
                            <span class="course-mentor-name">TS. Lê Văn Hải</span>
                            <span class="course-mentor-role">Cố vấn chuyên môn</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Lịch sử câu hỏi & Tiến trình thi gần đây -->
        <div class="section-header">
            <h2 class="section-title">Lịch sử câu hỏi & Lượt thi gần đây</h2>
            <a asp-controller="StudentReports" asp-action="Index" class="section-link">Xem tất cả</a>
        </div>

        <div class="lesson-table-wrap">
            <table class="lesson-table">
                <thead>
                    <tr>
                        <th>GIÁM KHẢO</th>
                        <th>CHỦ ĐỀ</th>
                        <th>NỘI DUNG TRẢ LỜI</th>
                        <th style="text-align: right;">CHI TIẾT</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <div class="table-mentor-cell">
                                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=80&q=80" alt="Avatar" class="table-mentor-avatar" />
                                <div>
                                    <div class="table-mentor-name">TS. Hoàng Yến</div>
                                    <div class="table-mentor-date">17/10/2026 · EXAM01</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="course-tag-pill tag-purple m-0">KIẾN TRÚC .NET</span></td>
                        <td>
                            <strong>Transient vs Scoped vs Singleton</strong>
                            <div class="small text-muted">Đã trả lời câu hỏi phụ về việc inject DbContext vào Singleton</div>
                        </td>
                        <td style="text-align: right;">
                            <a asp-controller="StudentReports" asp-action="Index" class="table-action-btn"><i class="bi bi-arrow-up-right"></i></a>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="table-mentor-cell">
                                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=80&q=80" alt="Avatar" class="table-mentor-avatar" />
                                <div>
                                    <div class="table-mentor-name">ThS. Minh Trí</div>
                                    <div class="table-mentor-date">16/10/2026 · EXAM01</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="course-tag-pill tag-cyan m-0">REALTIME HUB</span></td>
                        <td>
                            <strong>SignalR Group Security</strong>
                            <div class="small text-muted">Cô lập phòng thi theo từng SessionId để bảo mật luồng âm thanh</div>
                        </td>
                        <td style="text-align: right;">
                            <a asp-controller="StudentReports" asp-action="Index" class="table-action-btn"><i class="bi bi-arrow-up-right"></i></a>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="table-mentor-cell">
                                <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=80&q=80" alt="Avatar" class="table-mentor-avatar" />
                                <div>
                                    <div class="table-mentor-name">TS. Lê Văn Hải</div>
                                    <div class="table-mentor-date">15/10/2026 · EXAM01</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="course-tag-pill tag-pink m-0">SPEECH TO TEXT</span></td>
                        <td>
                            <strong>Whisper Audio Transcription</strong>
                            <div class="small text-muted">Nhận diện giọng nói chuẩn xác 96% qua microphone WebAudio</div>
                        </td>
                        <td style="text-align: right;">
                            <a asp-controller="StudentReports" asp-action="Index" class="table-action-btn"><i class="bi bi-arrow-up-right"></i></a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Right Statistic Column -->
    <div class="dashboard-side-col">
        <div class="statistic-panel">
            <div class="statistic-header">
                <h3 class="statistic-title">Statistic</h3>
                <button type="button" class="statistic-more-btn"><i class="bi bi-three-dots-vertical"></i></button>
            </div>

            <div class="statistic-user-card">
                <div class="avatar-progress-container">
                    <div class="avatar-progress-ring">
                        <div class="avatar-progress-inner">
                            <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=160&q=80" alt="Avatar" class="avatar-progress-img" />
                        </div>
                    </div>
                    <span class="avatar-percentage-badge">85%</span>
                </div>

                <div class="statistic-user-greeting">Xin chào, @userName 🔥</div>
                <div class="statistic-user-sub">Tiếp tục hoàn thành bài thi vấn đáp hôm nay để đạt mục tiêu nhé!</div>
            </div>

            <!-- Mini Bar Chart -->
            <div class="chart-card">
                <div class="chart-bars-wrap">
                    <div class="chart-bar-col"><div class="chart-bar-pillar" style="height: 40%;"></div></div>
                    <div class="chart-bar-col"><div class="chart-bar-pillar" style="height: 65%;"></div></div>
                    <div class="chart-bar-col"><div class="chart-bar-pillar active" style="height: 90%;"></div></div>
                    <div class="chart-bar-col"><div class="chart-bar-pillar" style="height: 45%;"></div></div>
                </div>
                <div class="chart-axis-labels">
                    <span>1-10 Oct</span>
                    <span>11-20 Oct</span>
                    <span>21-30 Oct</span>
                    <span>Hôm nay</span>
                </div>
            </div>

            <!-- Your Mentor List -->
            <div>
                <div class="mentor-list-header">
                    <h4 class="mentor-list-title">Hội đồng khảo thí AI</h4>
                    <button type="button" class="mentor-add-btn"><i class="bi bi-plus-lg"></i></button>
                </div>

                <div class="mentor-items-list">
                    <div class="mentor-item">
                        <div class="mentor-profile-group">
                            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=80&q=80" alt="Mentor" class="mentor-pic" />
                            <div class="mentor-text-info">
                                <span class="mentor-name">TS. Hoàng Yến</span>
                                <span class="mentor-role">Giám khảo AI</span>
                            </div>
                        </div>
                        <a href="javascript:void(0)" class="btn-follow"><i class="bi bi-person-plus"></i> Follow</a>
                    </div>

                    <div class="mentor-item">
                        <div class="mentor-profile-group">
                            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=80&q=80" alt="Mentor" class="mentor-pic" />
                            <div class="mentor-text-info">
                                <span class="mentor-name">ThS. Minh Trí</span>
                                <span class="mentor-role">Hỏi xoáy LLM</span>
                            </div>
                        </div>
                        <a href="javascript:void(0)" class="btn-follow"><i class="bi bi-person-plus"></i> Follow</a>
                    </div>

                    <div class="mentor-item">
                        <div class="mentor-profile-group">
                            <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=80&q=80" alt="Mentor" class="mentor-pic" />
                            <div class="mentor-text-info">
                                <span class="mentor-name">TS. Lê Văn Hải</span>
                                <span class="mentor-role">Cố vấn kiến trúc</span>
                            </div>
                        </div>
                        <a href="javascript:void(0)" class="btn-follow"><i class="bi bi-person-plus"></i> Follow</a>
                    </div>
                </div>

                <a asp-page="/Viva/Index" class="btn-see-all-mentors">Xem tất cả phòng thi</a>
            </div>
        </div>
    </div>
</div>
