@using AIVES.BLL.Security
@{
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? ApplicationRoles.Staff;
    var overrideRole = ViewData["ActiveRoleOverride"] as string;
    var effectiveRole = !string.IsNullOrEmpty(overrideRole) ? overrideRole : userRole;

    ViewData["Title"] = effectiveRole switch
    {
        ApplicationRoles.Admin => "Admin Dashboard",
        ApplicationRoles.Lecturer => "Lecturer Dashboard",
        _ => "Student Dashboard"
    };
}

@if (effectiveRole == ApplicationRoles.Admin)
{
    @await Html.PartialAsync("AdminDashboard")
}
else if (effectiveRole == ApplicationRoles.Lecturer)
{
    @await Html.PartialAsync("LecturerDashboard")
}
else
{
    @await Html.PartialAsync("StudentDashboard")
}
