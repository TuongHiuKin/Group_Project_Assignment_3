@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using AIVES.BLL.Security
@{
    var roleClaimValue = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
    var friendlyRole = roleClaimValue switch
    {
        ApplicationRoles.Admin => "Quản trị viên",
        ApplicationRoles.Lecturer => "Giảng viên",
        ApplicationRoles.Staff => "Sinh viên",
        _ => "Thí sinh"
    };
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString();
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var isAuth = User.Identity?.IsAuthenticated == true;

    var emailClaim = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
    var subClaim = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

    var sessionMssv = Context.Request.Cookies["Student_StudentId"];
    var sessionClass = Context.Request.Cookies["Student_ClassId"];
    var sessionName = Context.Request.Cookies["Student_Name"];

    string studentMssv = !string.IsNullOrWhiteSpace(sessionMssv) ? sessionMssv : "SV01";
    if (string.IsNullOrWhiteSpace(sessionMssv))
    {
        if (emailClaim.Contains("sv02", StringComparison.OrdinalIgnoreCase) || emailClaim.Contains("student2", StringComparison.OrdinalIgnoreCase) || subClaim == "2")
            studentMssv = "SV02";
        else if (emailClaim.Contains("sv03", StringComparison.OrdinalIgnoreCase) || emailClaim.Contains("student3", StringComparison.OrdinalIgnoreCase) || subClaim == "3")
            studentMssv = "SV03";
    }

    string studentClass = !string.IsNullOrWhiteSpace(sessionClass) ? sessionClass : (studentMssv == "SV03" ? "SE1702" : "SE1701");
    string studentMajor = Context.Request.Cookies["Student_Major"] ?? (studentClass == "SE1702" ? "Trí tuệ nhân tạo (AI)" : "Kỹ thuật phần mềm (SE)");
    string studentTeacher = Context.Request.Cookies["Student_Lecturer"] ?? (studentClass == "SE1702" ? "ThS. Minh Trí (GV02)" : (studentClass == "SE1703" ? "TS. Lê Văn Hải (GV03)" : "TS. Hoàng Yến (GV01)"));
    string studentFullName = !string.IsNullOrWhiteSpace(sessionName) ? sessionName : (User.Identity?.Name ?? (studentMssv switch
    {
        "SV02" => "Trần Thị B",
        "SV03" => "Lê Văn C",
        _ => "Nguyễn Văn A"
    }));
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AIVES Viva Exam</title>
    <!-- Modern Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (isAuth)
    {
        <div class="app-shell">
            <div class="app-frame">
                <!-- 1. LEFT SIDEBAR (Identical to reference screenshot) -->
                <aside class="app-sidebar" id="appSidebar">
                    <div>
                        <!-- Logo & Brand Header -->
                        <a asp-controller="Account" asp-action="Dashboard" class="brand-header">
                            <div class="brand-icon-box">
                                <i class="bi bi-stars"></i>
                            </div>
                            <span class="brand-title">AIVES</span>
                        </a>

                        <!-- Category: ROLE-DEDICATED NAVIGATION -->
                        @if (User.IsInRole(ApplicationRoles.Admin))
                        {
                            <div class="sidebar-category">QUẢN TRỊ VIÊN</div>
                            <ul class="sidebar-nav-list">
                                <li class="sidebar-nav-item @(string.Equals(currentCtrl, "Account", StringComparison.OrdinalIgnoreCase) && (string.Equals(currentAct, "AdminDashboard", StringComparison.OrdinalIgnoreCase) || string.Equals(currentAct, "Dashboard", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                                    <a asp-controller="Account" asp-action="AdminDashboard">
                                        <i class="bi bi-grid-fill"></i>
                                        <span>Dashboard Admin</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(string.Equals(currentCtrl, "Account", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAct, "Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-controller="Account" asp-action="Index">
                                        <i class="bi bi-people-fill"></i>
                                        <span>Quản lý Tài khoản</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(string.Equals(currentCtrl, "ClassReports", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-controller="ClassReports" asp-action="Index">
                                        <i class="bi bi-bar-chart-steps"></i>
                                        <span>Báo cáo Học vụ</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(currentPage != null && currentPage.Equals("/Viva/CreateExam", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-page="/Viva/CreateExam">
                                        <i class="bi bi-plus-circle-fill"></i>
                                        <span>Tạo phòng thi</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(currentPage != null && currentPage.Equals("/Viva/Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-page="/Viva/Index">
                                        <i class="bi bi-mic-fill"></i>
                                        <span>Cổng thi Viva</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(currentPage != null && currentPage.StartsWith("/Admin/AiSettings", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-page="/Admin/AiSettings">
                                        <i class="bi bi-robot"></i>
                                        <span>Cấu hình AI</span>
                                    </a>
                                </li>
                            </ul>
                        }
                        else if (User.IsInRole(ApplicationRoles.Lecturer))
                        {
                            <div class="sidebar-category">GIẢNG VIÊN</div>
                            <ul class="sidebar-nav-list">
                                <li class="sidebar-nav-item @(string.Equals(currentCtrl, "Account", StringComparison.OrdinalIgnoreCase) && (string.Equals(currentAct, "LecturerDashboard", StringComparison.OrdinalIgnoreCase) || string.Equals(currentAct, "Dashboard", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                                    <a asp-controller="Account" asp-action="LecturerDashboard">
                                        <i class="bi bi-grid-fill"></i>
                                        <span>Dashboard Giảng viên</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(string.Equals(currentCtrl, "ClassReports", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-controller="ClassReports" asp-action="Index">
                                        <i class="bi bi-bar-chart-steps"></i>
                                        <span>Thống kê Lớp học</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(currentPage != null && currentPage.Equals("/Viva/CreateExam", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-page="/Viva/CreateExam">
                                        <i class="bi bi-plus-circle-fill"></i>
                                        <span>Tạo phòng thi Viva</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(currentPage != null && currentPage.Equals("/Viva/Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-page="/Viva/Index">
                                        <i class="bi bi-camera-video-fill"></i>
                                        <span>Cổng thi Viva</span>
                                    </a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <div class="sidebar-category">SINH VIÊN</div>
                            <ul class="sidebar-nav-list">
                                <li class="sidebar-nav-item @(string.Equals(currentCtrl, "Account", StringComparison.OrdinalIgnoreCase) && (string.Equals(currentAct, "StudentDashboard", StringComparison.OrdinalIgnoreCase) || string.Equals(currentAct, "Dashboard", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                                    <a asp-controller="Account" asp-action="StudentDashboard">
                                        <i class="bi bi-grid-fill"></i>
                                        <span>Dashboard Sinh viên</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(currentPage != null && currentPage.StartsWith("/Viva", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-page="/Viva/Index">
                                        <i class="bi bi-camera-video-fill"></i>
                                        <span>Phòng thi Viva</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(string.Equals(currentCtrl, "StudentReports", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-controller="StudentReports" asp-action="Index">
                                        <i class="bi bi-journal-check"></i>
                                        <span>Báo cáo cá nhân</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(string.Equals(currentCtrl, "Account", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAct, "Profile", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-vcard-fill"></i>
                                        <span>Thông tin cá nhân</span>
                                    </a>
                                </li>
                            </ul>
                        }

                        <!-- Category: FRIENDS / AI EXAMINERS -->
                        <div class="sidebar-category">EXAMINERS</div>
                        <div class="d-flex flex-column gap-1">
                            <div class="sidebar-avatar-item">
                                <div class="sidebar-avatar-wrapper">
                                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=80&q=80" alt="Examiner" class="sidebar-avatar-img" />
                                    <span class="sidebar-status-dot"></span>
                                </div>
                                <div class="sidebar-avatar-info">
                                    <span class="sidebar-avatar-name">TS. Hoàng Yến</span>
                                    <span class="sidebar-avatar-role">Giám khảo AI</span>
                                </div>
                            </div>
                            <div class="sidebar-avatar-item">
                                <div class="sidebar-avatar-wrapper">
                                    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=80&q=80" alt="Examiner" class="sidebar-avatar-img" />
                                    <span class="sidebar-status-dot"></span>
                                </div>
                                <div class="sidebar-avatar-info">
                                    <span class="sidebar-avatar-name">ThS. Minh Trí</span>
                                    <span class="sidebar-avatar-role">Hỏi xoáy LLM</span>
                                </div>
                            </div>
                            <div class="sidebar-avatar-item">
                                <div class="sidebar-avatar-wrapper">
                                    <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=80&q=80" alt="Examiner" class="sidebar-avatar-img" />
                                    <span class="sidebar-status-dot"></span>
                                </div>
                                <div class="sidebar-avatar-info">
                                    <span class="sidebar-avatar-name">TS. Lê Văn Hải</span>
                                    <span class="sidebar-avatar-role">Cố vấn chuyên môn</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </aside>

                <!-- 2. MAIN WORKSPACE AREA -->
                <div class="app-main">
                    <!-- Topbar Header -->
                    <header class="app-topbar">
                        <!-- Mobile Sidebar Toggle Button -->
                        <button type="button" class="sidebar-toggler me-3" id="sidebarToggler" aria-label="Toggle menu">
                            <i class="bi bi-list"></i>
                        </button>

                        <!-- Search Bar -->
                        <div class="topbar-search-box">
                            <i class="bi bi-search topbar-search-icon"></i>
                            <input type="text" class="topbar-search-input" placeholder="Tìm kiếm bài thi, môn học, câu hỏi..." />
                        </div>

                        <!-- Action Icons & User Profile -->
                        <div class="topbar-actions">
                            <button type="button" class="topbar-circle-btn" title="Tin nhắn">
                                <i class="bi bi-envelope"></i>
                            </button>
                            <button type="button" class="topbar-circle-btn" title="Thông báo">
                                <i class="bi bi-bell"></i>
                                <span class="topbar-badge-dot"></span>
                            </button>

                            <!-- Profile avatar dropdown -->
                            <div class="dropdown">
                                <button type="button" class="topbar-user-profile" id="userProfileDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Menu tài khoản">
                                    <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80" alt="Avatar" class="topbar-user-avatar" />
                                    <div class="d-none d-md-block text-start">
                                        <div class="topbar-user-name">@(User.Identity?.Name ?? "Người dùng")</div>
                                        <div class="topbar-user-role">@friendlyRole</div>
                                    </div>
                                    <i class="bi bi-chevron-down topbar-user-chevron ms-1"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end topbar-user-dropdown shadow-sm" aria-labelledby="userProfileDropdown">
                                    <li class="topbar-dropdown-header px-3 py-2">
                                        <div class="fw-bold text-dark text-truncate">@(User.Identity?.Name ?? "Người dùng")</div>
                                        <div class="small text-muted d-flex align-items-center gap-1">
                                            <span>@friendlyRole</span>
                                            @if (roleClaimValue == ApplicationRoles.Staff)
                                            {
                                                <span class="badge tag-purple" style="font-size: 10px;">Lớp @studentClass</span>
                                            }
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider my-1" /></li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2 py-2 @(string.Equals(currentCtrl, "Account", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAct, "Profile", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-badge text-primary"></i>
                                            <span>Thông tin cá nhân</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2 py-2" asp-controller="Account" asp-action="Dashboard">
                                            <i class="bi bi-gear text-secondary"></i>
                                            <span>Cài đặt</span>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger">
                                                <i class="bi bi-box-arrow-right"></i>
                                                <span>Đăng xuất</span>
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </header>

                    <!-- Page Body Contents -->
                    <main class="app-body">
                        @if (TempData["SuccessMessage"] is string successMessage)
                        {
                            <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="status">
                                <i class="bi bi-check-circle-fill me-2 text-success"></i> @successMessage
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                            </div>
                        }
                        @if (TempData["ErrorMessage"] is string errorMessage)
                        {
                            <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @errorMessage
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                            </div>
                        }

                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Unauthenticated Layout (Centered modern card) -->
        <div class="app-shell align-items-center justify-content-center">
            <div class="p-3 w-100" style="max-width: 480px;">
                @RenderBody()
            </div>
        </div>
    }

    <!-- Nơi render Popup Modal động -->
    <div id="modalContainer" aria-live="polite"></div>

    <!-- Modal: Thông tin cá nhân sinh viên & Phân lớp học phần -->
    <div class="modal fade" id="userProfileModal" tabindex="-1" aria-labelledby="userProfileModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-0 pb-0 text-white" style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-person-badge-fill fs-4"></i>
                        <h5 class="modal-title fw-bold" id="userProfileModalLabel">
                            @(roleClaimValue == ApplicationRoles.Staff ? "Hồ Sơ Sinh Viên & Lớp Học Phần" : "Thông Tin Tài Khoản")
                        </h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body p-4 pt-3">
                    <div class="text-center pb-3 border-bottom mb-3">
                        <div class="position-relative d-inline-block mb-2">
                            <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=120&q=80" 
                                 alt="Avatar" class="rounded-circle shadow-sm border border-3 border-white" style="width: 80px; height: 80px; object-fit: cover;" />
                            <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-white rounded-circle" title="Trạng thái hoạt động"></span>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">
                            @(roleClaimValue == ApplicationRoles.Staff ? $"{studentFullName} ({studentMssv})" : (User.Identity?.Name ?? "Người dùng"))
                        </h5>
                        <div class="d-flex justify-content-center gap-2">
                            <span class="badge tag-purple">@friendlyRole</span>
                            @if (roleClaimValue == ApplicationRoles.Staff)
                            {
                                <span class="badge tag-cyan"><i class="bi bi-building me-1"></i>Lớp: @studentClass</span>
                            }
                        </div>
                    </div>

                    @if (roleClaimValue == ApplicationRoles.Staff)
                    {
                        <!-- Chi tiết thông tin sinh viên và phân lớp cho Giảng viên -->
                        <div class="vstack gap-2">
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light">
                                <span class="text-muted small fw-semibold"><i class="bi bi-card-text me-2 text-primary"></i>Mã số sinh viên (MSSV)</span>
                                <span class="fw-bold text-primary">@studentMssv</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light">
                                <span class="text-muted small fw-semibold"><i class="bi bi-collection-fill me-2 text-purple"></i>Lớp học phần (GV chia lớp)</span>
                                <span class="fw-bold text-dark badge tag-purple fs-6">@studentClass</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light">
                                <span class="text-muted small fw-semibold"><i class="bi bi-person-video3 me-2 text-info"></i>Giảng viên phụ trách lớp</span>
                                <span class="fw-bold text-dark">@studentTeacher</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light">
                                <span class="text-muted small fw-semibold"><i class="bi bi-envelope-at me-2 text-danger"></i>Email học vụ</span>
                                <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(emailClaim) ? $"{studentMssv.ToLowerInvariant()}@fpt.edu.vn" : emailClaim)</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light">
                                <span class="text-muted small fw-semibold"><i class="bi bi-mortarboard-fill me-2 text-warning"></i>Ngành đào tạo</span>
                                <span class="fw-semibold text-dark">@studentMajor</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light">
                                <span class="text-muted small fw-semibold"><i class="bi bi-calendar3 me-2 text-secondary"></i>Khóa & Học kỳ</span>
                                <span class="fw-semibold text-dark">K17 &bull; Fall 2026</span>
                            </div>
                        </div>

                        <div class="mt-4 pt-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <a asp-controller="Account" asp-action="Profile" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold">
                                <i class="bi bi-pencil-square me-1"></i> Điều chỉnh thông tin
                            </a>
                            <div class="d-flex gap-2">
                                <a asp-controller="StudentReports" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-bold">
                                    <i class="bi bi-journal-text me-1"></i> Bảng điểm
                                </a>
                                <button type="button" class="btn btn-sm btn-light border rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="vstack gap-2">
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light">
                                <span class="text-muted small fw-semibold">Tên tài khoản</span>
                                <span class="fw-bold text-dark">@(User.Identity?.Name ?? "—")</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light">
                                <span class="text-muted small fw-semibold">Email</span>
                                <span class="fw-semibold text-dark">@emailClaim</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-3 bg-light">
                                <span class="text-muted small fw-semibold">Vai trò</span>
                                <span class="badge tag-purple">@friendlyRole</span>
                            </div>
                        </div>
                        <div class="mt-4 pt-2 border-top text-end">
                            <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Toggle mobile sidebar
        const toggler = document.getElementById('sidebarToggler');
        const sidebar = document.getElementById('appSidebar');
        if (toggler && sidebar) {
            toggler.addEventListener('click', () => {
                sidebar.classList.toggle('d-block');
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
