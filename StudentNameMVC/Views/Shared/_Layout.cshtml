@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using AIVES.BLL.Security
@{
    var roleClaimValue = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
    var friendlyRole = roleClaimValue switch
    {
        ApplicationRoles.Admin => "Quản trị viên",
        ApplicationRoles.Lecturer => "Giảng viên",
        ApplicationRoles.Staff => "Sinh viên",
        _ => "Thí sinh"
    };
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString();
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var isAuth = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AIVES Viva Exam</title>
    <!-- Modern Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (isAuth)
    {
        <div class="app-shell">
            <div class="app-frame">
                <!-- 1. LEFT SIDEBAR (Identical to reference screenshot) -->
                <aside class="app-sidebar" id="appSidebar">
                    <div>
                        <!-- Logo & Brand Header -->
                        <a asp-controller="Account" asp-action="Dashboard" class="brand-header">
                            <div class="brand-icon-box">
                                <i class="bi bi-stars"></i>
                            </div>
                            <span class="brand-title">AIVES</span>
                        </a>

                        <!-- Category: ROLE-DEDICATED NAVIGATION -->
                        @if (User.IsInRole(ApplicationRoles.Admin))
                        {
                            <div class="sidebar-category">QUẢN TRỊ VIÊN</div>
                            <ul class="sidebar-nav-list">
                                <li class="sidebar-nav-item @(string.Equals(currentCtrl, "Account", StringComparison.OrdinalIgnoreCase) && (string.Equals(currentAct, "AdminDashboard", StringComparison.OrdinalIgnoreCase) || string.Equals(currentAct, "Dashboard", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                                    <a asp-controller="Account" asp-action="AdminDashboard">
                                        <i class="bi bi-grid-fill"></i>
                                        <span>Dashboard Admin</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(string.Equals(currentCtrl, "Account", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAct, "Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-controller="Account" asp-action="Index">
                                        <i class="bi bi-people-fill"></i>
                                        <span>Quản lý Tài khoản</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(string.Equals(currentCtrl, "ClassReports", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-controller="ClassReports" asp-action="Index">
                                        <i class="bi bi-bar-chart-steps"></i>
                                        <span>Báo cáo Học vụ</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(currentPage != null && currentPage.StartsWith("/Viva", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-page="/Viva/Index">
                                        <i class="bi bi-mic-fill"></i>
                                        <span>Thử nghiệm Viva</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(currentPage != null && currentPage.StartsWith("/Admin/AiSettings", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-page="/Admin/AiSettings">
                                        <i class="bi bi-robot"></i>
                                        <span>Cấu hình AI</span>
                                    </a>
                                </li>
                            </ul>
                        }
                        else if (User.IsInRole(ApplicationRoles.Lecturer))
                        {
                            <div class="sidebar-category">GIẢNG VIÊN</div>
                            <ul class="sidebar-nav-list">
                                <li class="sidebar-nav-item @(string.Equals(currentCtrl, "Account", StringComparison.OrdinalIgnoreCase) && (string.Equals(currentAct, "LecturerDashboard", StringComparison.OrdinalIgnoreCase) || string.Equals(currentAct, "Dashboard", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                                    <a asp-controller="Account" asp-action="LecturerDashboard">
                                        <i class="bi bi-grid-fill"></i>
                                        <span>Dashboard Giảng viên</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(string.Equals(currentCtrl, "ClassReports", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-controller="ClassReports" asp-action="Index">
                                        <i class="bi bi-bar-chart-steps"></i>
                                        <span>Thống kê Lớp học</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(currentPage != null && currentPage.StartsWith("/Viva", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-page="/Viva/Index">
                                        <i class="bi bi-camera-video-fill"></i>
                                        <span>Phòng thi Viva</span>
                                    </a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <div class="sidebar-category">SINH VIÊN</div>
                            <ul class="sidebar-nav-list">
                                <li class="sidebar-nav-item @(string.Equals(currentCtrl, "Account", StringComparison.OrdinalIgnoreCase) && (string.Equals(currentAct, "StudentDashboard", StringComparison.OrdinalIgnoreCase) || string.Equals(currentAct, "Dashboard", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                                    <a asp-controller="Account" asp-action="StudentDashboard">
                                        <i class="bi bi-grid-fill"></i>
                                        <span>Dashboard Sinh viên</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(currentPage != null && currentPage.StartsWith("/Viva", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-page="/Viva/Index">
                                        <i class="bi bi-camera-video-fill"></i>
                                        <span>Phòng thi Viva</span>
                                    </a>
                                </li>
                                <li class="sidebar-nav-item @(string.Equals(currentCtrl, "StudentReports", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a asp-controller="StudentReports" asp-action="Index">
                                        <i class="bi bi-journal-check"></i>
                                        <span>Báo cáo cá nhân</span>
                                    </a>
                                </li>
                            </ul>
                        }

                        <!-- Category: FRIENDS / AI EXAMINERS -->
                        <div class="sidebar-category">EXAMINERS</div>
                        <div class="d-flex flex-column gap-1">
                            <div class="sidebar-avatar-item">
                                <div class="sidebar-avatar-wrapper">
                                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=80&q=80" alt="Examiner" class="sidebar-avatar-img" />
                                    <span class="sidebar-status-dot"></span>
                                </div>
                                <div class="sidebar-avatar-info">
                                    <span class="sidebar-avatar-name">TS. Hoàng Yến</span>
                                    <span class="sidebar-avatar-role">Giám khảo AI</span>
                                </div>
                            </div>
                            <div class="sidebar-avatar-item">
                                <div class="sidebar-avatar-wrapper">
                                    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=80&q=80" alt="Examiner" class="sidebar-avatar-img" />
                                    <span class="sidebar-status-dot"></span>
                                </div>
                                <div class="sidebar-avatar-info">
                                    <span class="sidebar-avatar-name">ThS. Minh Trí</span>
                                    <span class="sidebar-avatar-role">Hỏi xoáy LLM</span>
                                </div>
                            </div>
                            <div class="sidebar-avatar-item">
                                <div class="sidebar-avatar-wrapper">
                                    <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=80&q=80" alt="Examiner" class="sidebar-avatar-img" />
                                    <span class="sidebar-status-dot"></span>
                                </div>
                                <div class="sidebar-avatar-info">
                                    <span class="sidebar-avatar-name">TS. Lê Văn Hải</span>
                                    <span class="sidebar-avatar-role">Cố vấn chuyên môn</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Category: SETTINGS & LOGOUT -->
                    <div>
                        <div class="sidebar-category">SETTINGS</div>
                        <ul class="sidebar-nav-list">
                            <li class="sidebar-nav-item">
                                <a asp-controller="Account" asp-action="Dashboard">
                                    <i class="bi bi-gear"></i>
                                    <span>Cài đặt</span>
                                </a>
                            </li>
                            <li class="sidebar-nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="w-100 m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit">
                                        <i class="bi bi-box-arrow-right"></i>
                                        <span>Đăng xuất</span>
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </aside>

                <!-- 2. MAIN WORKSPACE AREA -->
                <div class="app-main">
                    <!-- Topbar Header -->
                    <header class="app-topbar">
                        <!-- Mobile Sidebar Toggle Button -->
                        <button type="button" class="sidebar-toggler me-3" id="sidebarToggler" aria-label="Toggle menu">
                            <i class="bi bi-list"></i>
                        </button>

                        <!-- Search Bar -->
                        <div class="topbar-search-box">
                            <i class="bi bi-search topbar-search-icon"></i>
                            <input type="text" class="topbar-search-input" placeholder="Tìm kiếm bài thi, môn học, câu hỏi..." />
                        </div>

                        <!-- Action Icons & User Profile -->
                        <div class="topbar-actions">
                            <button type="button" class="topbar-circle-btn" title="Tin nhắn">
                                <i class="bi bi-envelope"></i>
                            </button>
                            <button type="button" class="topbar-circle-btn" title="Thông báo">
                                <i class="bi bi-bell"></i>
                                <span class="topbar-badge-dot"></span>
                            </button>

                            <!-- Profile avatar -->
                            <div class="topbar-user-profile">
                                <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80" alt="Avatar" class="topbar-user-avatar" />
                                <div class="d-none d-md-block">
                                    <div class="topbar-user-name">@(User.Identity?.Name ?? "Người dùng")</div>
                                    <div class="topbar-user-role">@friendlyRole</div>
                                </div>
                            </div>
                        </div>
                    </header>

                    <!-- Page Body Contents -->
                    <main class="app-body">
                        @if (TempData["SuccessMessage"] is string successMessage)
                        {
                            <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="status">
                                <i class="bi bi-check-circle-fill me-2 text-success"></i> @successMessage
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                            </div>
                        }
                        @if (TempData["ErrorMessage"] is string errorMessage)
                        {
                            <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @errorMessage
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                            </div>
                        }

                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Unauthenticated Layout (Centered modern card) -->
        <div class="app-shell align-items-center justify-content-center">
            <div class="p-3 w-100" style="max-width: 480px;">
                @RenderBody()
            </div>
        </div>
    }

    <!-- Nơi render Popup Modal động -->
    <div id="modalContainer" aria-live="polite"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Toggle mobile sidebar
        const toggler = document.getElementById('sidebarToggler');
        const sidebar = document.getElementById('appSidebar');
        if (toggler && sidebar) {
            toggler.addEventListener('click', () => {
                sidebar.classList.toggle('d-block');
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
