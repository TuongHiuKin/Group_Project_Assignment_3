<mxfile host="app.diagrams.net" agent="Hermes" version="24.0.0"><diagram id="simple" name="Kiến trúc AIVES"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1170" pageHeight="880" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s1" value="&lt;b style='font-size:15px;color:#111827'&gt;Trình duyệt (người dùng)&lt;/b&gt;&lt;br&gt;HTML, Bootstrap, SignalR client, ghi âm JS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#9ca3af;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="240" y="30" width="620" height="60" as="geometry"/></mxCell><mxCell id="s2" value="Presentation Layer (StudentNameMVC)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=16;fontColor=#1d4ed8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="240" y="140" width="620" height="165" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b style='font-size:15px;color:#1d4ed8'&gt;Web App&lt;/b&gt;&lt;br&gt;startup project" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="150" height="50" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b style='font-size:13px;color:#111827'&gt;Razor Pages&lt;/b&gt;&lt;br&gt;Viva, Chấm điểm, Báo cáo,&lt;br&gt;Account, Admin AI" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="255" y="180" width="190" height="82" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b style='font-size:13px;color:#111827'&gt;SignalR Hub&lt;/b&gt;&lt;br&gt;VivaHub: JoinSession,&lt;br&gt;BeginAnswering, push events" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="455" y="180" width="190" height="82" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b style='font-size:13px;color:#111827'&gt;Security&lt;/b&gt;&lt;br&gt;Cookie auth, phân quyền&lt;br&gt;Admin / Staff / Lecturer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="655" y="180" width="190" height="82" as="geometry"/></mxCell><mxCell id="s6b" value="&lt;b style='font-size:12px;color:#111827'&gt;VivaTimerWorker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;BackgroundService — đếm ngược,&lt;br&gt;hết giờ tự chuyển câu&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;dashed=1;fontSize=10;fontColor=#1e40af;" vertex="1" parent="1"><mxGeometry x="255" y="268" width="590" height="30" as="geometry"/></mxCell><mxCell id="s7" value="Business Layer (AIVES.BLL)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=16;fontColor=#15803d;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="240" y="345" width="620" height="185" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b style='font-size:15px;color:#1d4ed8'&gt;.dll&lt;/b&gt;&lt;br&gt;Class Library projects" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="150" height="50" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b style='font-size:13px;color:#111827'&gt;Viva Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Orchestrator, đồng hồ,&lt;br&gt;follow-up, AnswerQualityGate&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="255" y="385" width="140" height="82" as="geometry"/></mxCell><mxCell id="s10" value="&lt;b style='font-size:13px;color:#111827'&gt;Grading Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;GradingOrchestrator (HITL),&lt;br&gt;chấm nền + audit log&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="405" y="385" width="140" height="82" as="geometry"/></mxCell><mxCell id="s11" value="&lt;b style='font-size:13px;color:#111827'&gt;Report Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;báo cáo SV,&lt;br&gt;thống kê lớp, xuất CSV&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="555" y="385" width="140" height="82" as="geometry"/></mxCell><mxCell id="s12" value="&lt;b style='font-size:13px;color:#111827'&gt;AI Abstractions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;STT, TTS, LLM, Grading&lt;br&gt;adapters + credential store&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="705" y="385" width="140" height="82" as="geometry"/></mxCell><mxCell id="s12b" value="&lt;b style='font-size:12px;color:#111827'&gt;VivaGradingBackgroundService&lt;/b&gt; &lt;font style='font-size:10px'&gt;— Channel queue + IServiceScopeFactory, chấm từng câu độc lập, fallback rubric khi AI lỗi&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#4ade80;dashed=1;fontSize=10;fontColor=#15803d;" vertex="1" parent="1"><mxGeometry x="255" y="478" width="590" height="34" as="geometry"/></mxCell><mxCell id="s13" value="Data Access Layer (AIVES.DAL)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=16;fontColor=#b91c1c;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="240" y="565" width="620" height="145" as="geometry"/></mxCell><mxCell id="s14" value="&lt;b style='font-size:15px;color:#1d4ed8'&gt;Data&lt;/b&gt;&lt;br&gt;AIVES.DAL" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="150" height="50" as="geometry"/></mxCell><mxCell id="s15" value="&lt;b style='font-size:13px;color:#111827'&gt;Repositories (Scoped)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Account, VivaSession, VivaTurn,&lt;br&gt;VivaQuestion, Rubric, Grading, Report&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="255" y="605" width="190" height="82" as="geometry"/></mxCell><mxCell id="s16" value="&lt;b style='font-size:13px;color:#111827'&gt;Entity Models (11)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;SystemAccount, VivaSession, VivaSessionTurn,&lt;br&gt;VivaQuestion, VivaRubricCriterion,&lt;br&gt;VivaGradingResult, VivaGradeChangeLog (+News×5)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="455" y="605" width="190" height="82" as="geometry"/></mxCell><mxCell id="s17" value="&lt;b style='font-size:13px;color:#111827'&gt;AIVESDbContext&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;EF Core (Database First)&lt;br&gt;Lifetime: Scoped&lt;br&gt;KHÔNG Singleton&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="655" y="605" width="190" height="82" as="geometry"/></mxCell><mxCell id="s18" value="&lt;b style='font-size:13px;color:#111827'&gt;AI bên ngoài (HTTPS)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;Gemini&lt;/b&gt; — gemini-3.8-flash-tts&lt;br&gt;&lt;b&gt;Groq&lt;/b&gt; — whisper-large-v3-turbo&lt;br&gt;&lt;b&gt;Groq&lt;/b&gt; — openai/gpt-oss-120b&lt;br&gt;&lt;b&gt;DeepSeek&lt;/b&gt; — deepseek-v4.1-flash&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=11;fontColor=#4b5563;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="925" y="345" width="215" height="102" as="geometry"/></mxCell><mxCell id="s19" value="&lt;b style='font-size:14px;color:#111827'&gt;SQL Server&lt;/b&gt;&lt;br&gt;AIVES (DB)&lt;br&gt;&lt;font style='font-size:10px'&gt;6 Viva + 5 News&lt;br&gt;9 rubric seeded&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.5;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="950" y="600" width="170" height="110" as="geometry"/></mxCell><mxCell id="s20" value="HTTP / SignalR" style="html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#1f2937;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="90" as="sourcePoint"/><mxPoint x="500" y="138" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s21" value="" style="html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#1f2937;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="140" as="sourcePoint"/><mxPoint x="600" y="92" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s22" value="" style="html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#1f2937;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="305" as="sourcePoint"/><mxPoint x="500" y="343" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s23" value="" style="html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#1f2937;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="345" as="sourcePoint"/><mxPoint x="600" y="307" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s24" value="" style="html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#1f2937;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="530" as="sourcePoint"/><mxPoint x="500" y="563" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s25" value="" style="html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#1f2937;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="565" as="sourcePoint"/><mxPoint x="600" y="532" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s26" value="HTTPS" style="html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#1f2937;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="862" y="400" as="sourcePoint"/><mxPoint x="923" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s27" value="" style="html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#1f2937;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="923" y="430" as="sourcePoint"/><mxPoint x="862" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s28" value="SQL" style="html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#1f2937;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="862" y="635" as="sourcePoint"/><mxPoint x="948" y="635" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s29" value="" style="html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#1f2937;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="948" y="670" as="sourcePoint"/><mxPoint x="862" y="670" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s30" value="&lt;b style='font-size:13px;color:#111827'&gt;Legends&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#9ca3af;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="925" y="30" width="215" height="112" as="geometry"/></mxCell><mxCell id="s31" value="" style="html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#1f2937;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="75" as="sourcePoint"/><mxPoint x="1005" y="75" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s32" value=": Request" style="text;html=1;fontSize=12;fontColor=#374151;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="65" width="100" height="20" as="geometry"/></mxCell><mxCell id="s33" value="" style="html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.5;strokeColor=#1f2937;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="102" as="sourcePoint"/><mxPoint x="1005" y="102" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s34" value=": Response" style="text;html=1;fontSize=12;fontColor=#374151;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="92" width="100" height="20" as="geometry"/></mxCell><mxCell id="s34b" value="&lt;font style='font-size:10px;color:#64748b'&gt;Chỉ BLL gọi AI.&lt;br&gt;DAL &lt;b&gt;không bao giờ&lt;/b&gt; gọi AI.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="937" y="112" width="195" height="26" as="geometry"/></mxCell><mxCell id="s35" value="&lt;b style='font-size:13px;color:#111827'&gt;Project references&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Web → BLL, DAL (DAL chỉ để đăng ký DI)&lt;br&gt;BLL → DAL&lt;br&gt;DAL không tham chiếu ngược&lt;br&gt;Repository &amp;amp; DbContext: &lt;b&gt;Scoped&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#9ca3af;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="925" y="725" width="215" height="95" as="geometry"/></mxCell><mxCell id="s36" value="Dữ liệu đi hai chiều: Request đi xuống, Response đi ngược lên. SignalR cho phép server chủ động đẩy sự kiện lên trình duyệt (kết quả STT, câu hỏi xoáy, trạng thái chấm điểm). Chấm điểm chạy nền: VivaGradingBackgroundService nhận job qua Channel, mỗi job tự tạo scope riêng để resolve scoped services; AI lỗi thì fallback rubric, không làm hỏng các câu khác." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4b5563;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="860" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
